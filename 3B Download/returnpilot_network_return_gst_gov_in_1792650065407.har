g = false;\r\n\t\t\t\t\tshareData.summaryFlag = $scope.summaryFlag;\r\n\t\t\t\t\t$scope.fail_msg = true;\r\n\t\t\t\t\t$scope.summaryMsg = response.error.message;\r\n\t\t\t\t}\r\n\t\t\t}, function (err) {\r\n\t\t\t\tvar url = $().getServers().GST_SERVICES_R1_URL + \"/services/error/system\";\r\n\t\t\t\t$window.location.href = url;\r\n\t\t\t});\r\n\t}\r\n\r\n\r\n\r\n\t//address \r\n\t$scope.addr = {};\r\n\t$scope.stateList = function () {\r\n\t\t//state dropdown\r\n\t\tajax.get('/master/allstates').then(function (response) {\r\n\t\t\t$scope.state = response.data;\r\n\t\t}, function (err) {\r\n\r\n\t\t});\r\n\t}\r\n\t$scope.distList = function (stcd) {\r\n\t\t//for state name\r\n\t\tfor (i = 0; i < $scope.state.length; i++) {\r\n\t\t\t$scope.stateInfo = $scope.state[i];\r\n\t\t\tif ($scope.stateInfo.c == stcd) {\r\n\t\t\t\t$scope.addr.state = $scope.stateInfo.n;\r\n\t\t\t}\r\n\t\t}\r\n\t\tajax.get(\"/master/st/\" + stcd + \"/district\").then(function (response) {\r\n\t\t\t$scope.district = response.data[0].n;\r\n\t\t});\r\n\t}\r\n\r\n\t//back_flag logic\r\n\r\n\t$scope.backflag = false;\r\n\tif (localStorage.getItem('BCK_FLAG') == 'E') {\r\n\t\t$scope.backflag = true;\r\n\t}\r\n\r\n\t$scope.showPdf = false;\r\n\t$scope.gstr10Data = function () {\r\n\t\tvar param = {\r\n\t\t\t\"rtn_prd\": shareData.gstr10_fp\r\n\t\t};\r\n\t\tajax.get(\"/returns2/auth/api/gstr10/summary\", param, {},\r\n\t\t\tfunction () {\r\n\t\t\t\t$().blockPage(true);\r\n\t\t\t}, function () {\r\n\t\t\t\t$().blockPage(false);\r\n\t\t\t}).then(function (response, status, header) {\r\n\t\t\t\tif (response.status == 1) {\r\n\t\t\t\t\t$scope.gstr10SumData = response.data;\r\n\t\t\t\t\tshareData.formdetails = response.data;...[truncated at 15000 chars]"

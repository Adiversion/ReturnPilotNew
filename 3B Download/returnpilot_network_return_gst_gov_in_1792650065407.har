          "content": {
            "size": 428060,
            "mimeType": "application/javascript",
            "text": "/*  @author:    Mohammed Aftab, Amrita Dubey\r\n    @created:   Sep-Nov 2016\r\n    @description: This file consists of controllers for GSTR1\r\n    @copyright: (c) Copyright by Infosys technologies\r\n  */\r\n\r\n/* \r\n    @description: Main controller\"\r\n  */\r\n'use strict'\r\n\r\n\r\n/*  \r\n    @description: Controller Returns Dashboard\"\r\n  */\r\n\r\n    myApp.controller(\"dashboardcrtl\", ['$scope', '$location', '$rootScope', 'shareData', '$timeout', '$window', 'version', 'cache', 'ajax', '$compile', \"$route\", '$http', '$filter', '$log', 'utilFunctions', 'FormSubmitter', function ($scope, $location, $rootScope, shareData, $timeout, $window, version, cache, ajax, $compile, $route, $http, $filter, $log, utilFunctions, FormSubmitter) {\r\n        sessionStorage.clear();\r\n        if ($().getConstant(\"rtn_prd\")) {\r\n            localStorage.setItem('rtn_prd', $().getConstant(\"rtn_prd\"));\r\n        }\r\n        if ($().getConstant(\"bck_flag\")) {\r\n            localStorage.setItem('BCK_FLAG', $().getConstant(\"bck_flag\"));\r\n        }\r\n        if ($().getConstant(\"formname\")) {\r\n            localStorage.setItem('formname', $().getConstant(\"formname\"));\r\n        }\r\n        if ($().getConstant(\"IFF_GO_LIVE_RTN_PRD\")) {\r\n            localStorage.setItem('IFF_GO_LIVE_RTN_PRD', $().getConstant(\"IFF_GO_LIVE_RTN_PRD\"));\r\n        }\r\n        if ($().getConstant(\"ECO_SUP_STRT_PRD\")) {\r\n            localStorage.setItem('ECO_SUP_STRT_PRD', $().getConstant(\"ECO_SUP_STRT_PRD\"));\r\n        }\r\n        else localStorage.setItem('ECO_SUP_STRT_PRD', \"062021\");\r\n   \r\n        $scope.showMessage = false;    \r\n        $scope.periodToDisplay = function(fmnth,fyr) {\r\n            $scope.year = null;\r\n            if(fmnth[\"value\"].slice(0, 2) != '16'){\r\n                $scope.year= fmnth[\"value\"].slice(-4);\r\n            } else {\r\n            $scope.year= fyr[\"year\"].slice(0,2) + fyr[\"year\"].slice(-2);\r\n            }\r\n            return fmnth[\"month\"] + ' ' + $scope.year; \r\n        }\r\n        \r\n        $scope.notifiedForms= [];\r\n        $scope.showBarredMsg = function(rtyp,fmnth,fyr,sbtyp) {\r\n            $scope.warningcontent= [];\r\n            rtyp = $scope.getSubType(rtyp,sbtyp);\r\n            if (!$scope.notifiedForms.includes(rtyp)) { \r\n            $scope.notifiedForms.push(rtyp);\r\n            }\r\n            $scope.yearToDisplay = null;\r\n            $scope.yearToDisplay = $scope.periodToDisplay(fmnth,fyr);\r\n            var sentence1 = $scope.notifiedForms.join(' & ');\r\n                var newDiv1 = { content: 'You are not allowed to file '+ sentence1 +' for tax period ' + $scope.yearToDisplay +' after the expiry of ' + $scope.gstr_barredYearsLimit + ' years from the respective due date of filing.'};\r\n                $scope.warningcontent.push(newDiv1);\r\n        $scope.showMessage = true;\r\n        }\r\n        $scope.closeWarningMsg = function () {\r\n            $scope.showMessage = false;\r\n            $scope.notifiedForms=[];\r\n            $scope.warningcontent=[];\r\n        }\r\n        $scope.getSubType = function (rtyp,sbtyp) {\r\n            if(sbtyp!=null && rtyp==\"GSTR1\" && sbtyp===\"IFF\")\r\n            {\r\n            rtyp = \"Invoice Furnishing Facility (IFF)\"  \r\n            }  else {\r\n                rtyp = rtyp.replace(/([a-zA-Z]+)(\\d+)/, '$1-$2');\r\n            }\r\n        return rtyp;\r\n        }\r\n     \r\n        $scope.ecoSupFlag = false;\r\n        $scope.compareEcoSup= function(){\r\n            const curr_rtn_prd = localStorage.getItem(\"rtn_prd\");\r\n            const curr_sup_strt_prd = localStorage.getItem(\"ECO_SUP_STRT_PRD\");\r\n            if(!curr_sup_strt_prd || curr_sup_strt_prd== \"null\")   return;\r\n            const ret_prd_month= curr_rtn_prd.substring(0, 2);\r\n            const ret_prd_year= curr_rtn_prd.substring(2);\r\n            const sup_strt_prd_month= curr_sup_strt_prd.substring(0, 2);\r\n            const sup_strt_prd_year= curr_sup_strt_prd.substring(2);\r\n            if(ret_prd_year > sup_strt_prd_year  || (ret_prd_year == sup_strt_prd_year && ret_prd_month >= sup_strt_prd_month ) ){\r\n                $scope.ecoSupFlag=true;\r\n                shareData.ecoSupFlag= $scope.ecoSupFlag;\r\n        \r\n            }\r\n            \r\n        }\r\n    \r\n        $scope.flag = \"\";\r\n        $scope.years = [];\r\n        localStorage.removeItem('efile_data');\r\n        $scope.isCmp08 = false;\r\n        $scope.handleMessages = function (iFlag, iType, iMsg) {\r\n    \r\n            if (iFlag) {\r\n    \r\n                $scope.showMsg = true;\r\n                $scope.mType = iType;\r\n                $scope.message = iMsg;\r\n    \r\n            } else {\r\n                $scope.showMsg = false;\r\n            }\r\n        };\r\n        //$scope.msme = {};\r\n    \r\n    \r\n        utilFunctions.initCache();\r\n        $scope.servers = $().getServers();\r\n        $scope.trans = utilFunctions.initLanguage('returns');\r\n        $rootScope.$on(\"LangChanged\", function (event, mass) {\r\n            $scope.trans = utilFunctions.initLanguage('returns');\r\n        });\r\n    \r\n        $scope.$on('$viewContentLoaded', function () {\r\n            $window.scrollTo(0, 0);\r\n            angular.element(document.querySelector('[autofocus]')).focus();\r\n        });\r\n        //CR-21773B : Ob button validations  (Amended date) \r\n        var obDetailDates = $scope.servers.RTN_REV_RCLM_OB_DETL.split('|');\r\n        var amendDate = new Date(obDetailDates[1]);\r\n        amendDate.setHours(0, 0, 0, 0);\r\n    \r\n        var now = new Date();\r\n        now.setHours(0, 0, 0, 0);\r\n        if (amendDate >= now) {\r\n            $scope.obPage = true;\r\n        } else {\r\n            $scope.obPage = false;\r\n        }\r\n        //CR-26198 : Ob button validations  (Amended date) \r\n        var rcmobDetailDates = $scope.servers.RTN_RCM_OB_DETL.split('|');\r\n        var rcmamendDate = new Date(rcmobDetailDates[1]);\r\n        rcmamendDate.setHours(0, 0, 0, 0);\r\n        if (rcmamendDate >= now) {\r\n            $scope.rcmobPage = true;\r\n        } else {\r\n            $scope.rcmobPage = false;\r\n        }\r\n        handleErrorAlert();\r\n        //handling of rror messages  \r\n        function handleErrorAlert() {\r\n            switch (shareData.invoiceSaveFlag) {\r\n                case 0:\r\n                    $scope.handleMessages(1, \"danger\", shareData.dash_fail_msg);\r\n                    break;\r\n                case 1:\r\n                    if ($scope.up_inv_msg) {\r\n                        $scope.handleMessages(1, \"success\", \"Invoices Uploaded successfully\" + $scope.up_inv_msg);\r\n                    }\r\n                    break;\r\n                default:\r\n                    $scope.handleMessages(0, null, null);\r\n                    break;\r\n            }\r\n            shareData.invoiceSaveFlag = -1;\r\n        }\r\n    \r\n        // functionality for page navigation.\r\n        $scope.page = function (path) {\r\n            $location.path(path);\r\n        }\r\n    \r\n        //variable initialized\r\n        shareData.subbtn = false;\r\n        //Functionality for generate GSTR-3\r\n        $scope.GenerateButton = function () {\r\n            ajax.get(\"/returns/auth/api/gstr3/gener?rtn_prd=\" + shareData.rtn_prd).then(function (response) {\r\n                if ((response.status === 0)) {\r\n                    //If Error comes in pushing data to ledger tables\r\n                    if (response.error.errorCode === \"LEDG01\") {\r\n    \r\n                        var conf = utilFunctions.createAlert({\r\n                            \"title\": response.error.message,\r\n                            \"type\": \"danger\",\r\n                            \"message\": \"\"\r\n                        });\r\n                        $('[name=generate]').empty();\r\n                        $('[name=generate]').append($compile(conf)($scope));\r\n                        $(\"#generate\").fadeTo(6000, 500).slideUp(500, function () {\r\n                            $(\"#generate\").slideUp(500);\r\n                        });\r\n                        $window.scrollTo(0, 0);\r\n                    }\r\n                    //If GSTR-1 and GSTR-2 are not filed\r\n                    else if (response.error.errorCode === \"GEN01\") {\r\n    \r\n                        var conf = utilFunctions.createAlert({\r\n                            \"title\": response.error.message,\r\n                            \"type\": \"warning\",\r\n                            \"message\": \"\"\r\n                        });\r\n                        $('[name=generate]').empty();\r\n                        $('[name=generate]').append($compile(conf)($scope));\r\n                        $(\"#generate\").fadeTo(6000, 500).slideUp(500, function () {\r\n                            $(\"#generate\").slideUp(500);\r\n                        });\r\n                        $window.scrollTo(0, 0);\r\n                    }\r\n                    //If GSTR-3 is already generated\r\n                    else if (response.error.errorCode === \"GEN02\") {\r\n    \r\n                        $scope.generate = true;\r\n                        shareData.generate = $scope.generate;\r\n                        var conf = utilFunctions.createAlert({\r\n                            \"title\": response.error.message,\r\n                            \"type\": \"info\",\r\n                            \"message\": \"\"\r\n                        });\r\n                        $('[name=generate]').empty();\r\n                        $('[name=generate]').append($compile(conf)($scope));\r\n                        $(\"#generate\").fadeTo(6000, 500).slideUp(500, function () {\r\n                            $(\"#generate\").slideUp(500);\r\n                        });\r\n                        $window.scrollTo(0, 0);\r\n                    }\r\n                    //If GSTR-1 and GSTR-2 submit calculations are not processed OR If previous month's filed return is not valid OR GSTR3B is not filed for current return period\r\n                    else if (response.error.errorCode === \"GEN07\" || response.error.errorCode === \"GEN08\" || response.error.errorCode === \"GEN09\") {\r\n                        var conf = utilFunctions.createAlert({\r\n                            \"title\": response.error.message,\r\n                            \"type\": \"danger\",\r\n                            \"message\": \"\"\r\n                        });\r\n                        $('[name=generate]').empty();\r\n                        $('[name=generate]').append($compile(conf)($scope));\r\n                        $(\"#generate\").fadeTo(6000, 500).slideUp(500, function () {\r\n                            $(\"#generate\").slideUp(500);\r\n                        });\r\n                        $window.scrollTo(0, 0);\r\n                    }\r\n                    //If any error comes in Generate GSTR-3\r\n                    else {\r\n    \r\n                        var conf = utilFunctions.createAlert({\r\n                            \"title\": response.error.message,\r\n                            \"type\": \"danger\",\r\n                            \"message\": \"\"\r\n                        });\r\n                        $('[name=generate]').empty();\r\n                        $('[name=generate]').append($compile(conf)($scope));\r\n                        $(\"#generate\").fadeTo(6000, 500).slideUp(500, function () {\r\n                            $(\"#generate\").slideUp(500);\r\n                        });\r\n                        $window.scrollTo(0, 0);\r\n                    }\r\n                }\r\n                //If GSTR-3 is Generated successfully\r\n                else if (response.status === 1) {\r\n                    $scope.generate = true;\r\n                    shareData.generate = $scope.generate;\r\n                    var conf = utilFunctions.createAlert({\r\n                        \"title\": response.data.message,\r\n                        \"type\": \"success\",\r\n                        \"message\": \"\"\r\n                    });\r\n                    $('[name=generate]').empty();\r\n                    $('[name=generate]').append($compile(conf)($scope));\r\n                    $(\"#generate\").fadeTo(6000, 500).slideUp(500, function () {\r\n                        $(\"#generate\").slideUp(500);\r\n                    });\r\n                    $window.scrollTo(0, 0);\r\n                }\r\n            })\r\n        }\r\n    \r\n        // Upload a JSON from offline utility\r\n        $scope.upload = function (uploadinv) {\r\n            $scope.uploadflag = false;\r\n            if (uploadinv) {\r\n                $scope.uploadflag = false;\r\n                $().blockPage(true);\r\n                ajax.post(\"auth/api/gstr1/save\", uploadinv).then(function (response) {\r\n                    $().blockPage(false);\r\n                    //if response is success then status is 1. Display the response message with transaction ID.\r\n                    if (response.status == 1) {\r\n                        shareData.invoiceSaveFlag = response.status;\r\n                        $scope.up_inv_msg = response.data.reference_id;\r\n                        $(\"#model\").modal(\"hide\");\r\n                    }\r\n                    //if response is failure then status is 0. Display the response message with failure message.\r\n                    else {\r\n                        $().blockPage(false);\r\n                        shareData.invoiceSaveFlag = response.status;\r\n                        shareData.dash_fail_msg = response.error.message;\r\n                        $(\"#model\").modal(\"hide\");\r\n                    }\r\n                });\r\n            } else {\r\n                $scope.uploadflag = true;\r\n                $scope.uploadFile = \"Please first choose the file then click on upload button\";\r\n            }\r\n    \r\n        };\r\n        //common filing method for GSTRs\r\n        var path = $location.path();\r\n        $scope.prepareForFile = function (formType) {\r\n    \r\n            var dataObj = {\r\n                \"rtn_prd\": shareData.rtn_prd,\r\n                \"form_type\": formType,\r\n                \"path\": path\r\n            };\r\n            localStorage.setItem(\"dataObj\", JSON.stringify(dataObj));\r\n            window.location.href = '/returns/auth/file';\r\n        }\r\n    \r\n        //page navigation and setting due date and filling status\r\n        $scope.page_rtp = function (path, due, stat) {\r\n            var version = $().getConstant('GST_RETURN_VER');\r\n            shareData.success_msg = false;\r\n            shareData.fail_msg = false;\r\n            $scope.message = \"\";\r\n            shareData.due_date = due;\r\n            shareData.filing_stat = stat;\r\n            localStorage.setItem(\"BCK_FLAG\", \"D\");\r\n            localStorage.setItem(\"formname\", path);\r\n            //if clicked on GSTR-1 tile\r\n            if (path == \"GSTR1\") {\r\n                /* FormSubmitter.submit(\"auth/gstr1\", \"POST\", {\r\n                    \"RTN_PRD\":shareData.rtn_prd\r\n                } */\r\n                window.location.href = '/returns/auth/gstr1';\r\n            }\r\n            //if clicked on GSTR -1EX tile\r\n            else if (path == \"GSTR1E\") {\r\n                window.location.href = '/returns/auth/gstr1ex';\r\n            }\r\n            //if clicked on GSTR-2 tile\r\n            else if (path == \"GSTR2\") {\r\n                /* FormSubmitter.submit(\"auth/gstr2\", \"POST\", {\r\n                    \"RTN_PRD\":shareData.rtn_prd\r\n            ...[truncated at 15000 chars]"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 428060
        },
        "cache": {},
        "timings": {
          "send": 0,

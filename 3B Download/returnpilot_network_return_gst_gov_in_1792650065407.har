          "content": {
            "size": 1531,
            "mimeType": "application/javascript",
            "text": "// CR 23810 Spike Engine\r\n\"use strict\";\r\n\r\nmyApp.controller(\"rtnCmpCtrl\", [\r\n  \"$scope\",\r\n  \"$location\",\r\n  \"$rootScope\",\r\n  \"shareData\",\r\n  \"$timeout\",\r\n  \"$window\",\r\n  \"version\",\r\n  \"cache\",\r\n  \"ajax\",\r\n  \"$compile\",\r\n  \"$route\",\r\n  \"$http\",\r\n  \"$filter\",\r\n  \"$log\",\r\n  \"utilFunctions\",\r\n  \"FormSubmitter\",\r\n  function (\r\n    $scope,\r\n    $location,\r\n    $rootScope,\r\n    shareData,\r\n    $timeout,\r\n    $window,\r\n    version,\r\n    cache,\r\n    ajax,\r\n    $compile,\r\n    $route,\r\n    $http,\r\n    $filter,\r\n    $log,\r\n    utilFunctions,\r\n    FormSubmitter\r\n  ) {\r\n    sessionStorage.clear();\r\n\r\n    utilFunctions.initCache();\r\n    $scope.servers = $().getServers();\r\n    $scope.trans = utilFunctions.initLanguage(\"returns\");\r\n    $rootScope.$on(\"LangChanged\", function (event, mass) {\r\n      $scope.trans = utilFunctions.initLanguage(\"returns\");\r\n    });\r\n    $scope.dashboardFlag = true;\r\n    $scope.enableliability = (Number($filter('date')(new Date(), 'yyyyMMdd')) >= Number($scope.servers.LIAB_CALC_DT)) ? true : false;\r\n    $scope.initCompliance = function(){\r\n        $scope.dashboardFlag = true;\r\n    }\r\n\r\n    // Navigating To respective Compliance\r\n    $scope.navigateToCompliance = function (path) {\r\n      window.location.href =\r\n        $scope.servers[\"GST_RETURNS_R1_URL\"] + \"/returns/auth/\"+path;\r\n    };\r\n\r\n    // Navigating To Return Dashboard\r\n    $scope.navigateToDashboard = function () {\r\n      window.location.href =\r\n        $scope.servers[\"GST_RETURNS_R1_URL\"] + \"/returns/auth/dashboard\";\r\n    };\r\n  },\r\n]);\r\n"
          },

          "content": {
            "size": 416600,
            "mimeType": "application/javascript",
            "text": "/*  @author:    Mohammed Aftab, Amrita Dubey\r\n    @created:   Sep-Nov 2016\r\n    @description: This file consists of controllers for GSTR1\r\n    @copyright: (c) Copyright by Infosys technologies\r\n  */\r\n\r\n/* \r\n    @description: Main controller\"\r\n  */\r\n    'use strict'\r\n    myApp.controller(\"mainctrl\", ['$scope', 'shareData', 'cache', '$rootScope', 'ajax', '$location', 'utilFunctions', '$window', '$q', '$compile', '$timeout', 'validations', 'FormSubmitter', 'NgTableParams', '$filter', 'constants', function ($scope, shareData, cache, $rootScope, ajax, $location, utilFunctions, $window, $q, $compile, $timeout, validations, FormSubmitter, NgTableParams, $filter, constants) {\r\n        /* \r\n            @alert: Code common to all functions can only be written\"\r\n          */\r\n        //language \r\n        //$scope.validations=validations;\r\n        $rootScope.timelimit = 5000;\r\n        $scope.dtflag = false;\r\n        $scope.dupInvNo = shareData.dupInvNo;\r\n        $scope.conerr = false;\r\n        $scope.gt_man = false;\r\n        $scope.uploadflag = false;\r\n        $scope.cnt = null;\r\n        var dateFormat = $().getConstant('DATE_FORMAT') || 'DD/MM/YYYY';\r\n        $scope.connerrmsg = \"Unable to connect to server due to some technical issue\";\r\n        utilFunctions.initCache();\r\n        if(localStorage.getItem('countergstr3b')=='Y'){\r\n            localStorage.removeItem('countergstr3b');\r\n        }\r\n        var HSN_BIFURCATION_START_DATE = $().getConstant('HSN_BIFURCATION_START_DATE');\r\n        $scope.servers = $().getServers();\r\n        \r\n        var  dropdown={\r\n                    \"data\":{\r\n                        \"values\":[\r\n                        {\r\n                                        \"qurtr\": \"April-June\",\r\n                                        \"value\": \"062020\"\r\n                                      },\r\n                                     {\r\n                                        \"qurtr\": \"July-Sept\",\r\n                                        \"value\": \"092020\"\r\n                                      },\r\n                                     {\r\n                                        \"qurtr\": \"Oct-Dec\",\r\n                                        \"value\": \"122020\"\r\n                                      },\r\n                                      {\r\n                                        \"qurtr\": \"Jan-Mar\",\r\n                                        \"value\": \"032021\"\r\n                                      }\r\n                        ]\r\n                    }\r\n                };\r\n                $scope.qurtr = dropdown.data.values;\r\n            $scope.frmqrtr = $scope.qurtr[0];\r\n            $scope.toqrtr = $scope.qurtr[$scope.qurtr.length - 1];\r\n        //added for masking changes CR17153\r\n        if ($().getConstant(constants.COMP_REPORT_FLAG)){\r\n            $scope.compFlag = $().getConstant(constants.COMP_REPORT_FLAG);\r\n        };\r\n        $scope.trans = utilFunctions.initLanguage('returns');\r\n        $rootScope.$on(\"LangChanged\", function (event, mass) {\r\n            $scope.trans = utilFunctions.initLanguage('returns');\r\n        });\r\n    \r\n        $scope.$on('$viewContentLoaded', function () {\r\n            $window.scrollTo(0, 0);\r\n            angular.element(document.querySelector('[autofocus]')).focus();\r\n        });\r\n        \r\n         $scope.formatDate = function (e, ui) {\r\n            var d = e;\r\n            if(d == \"\" || d== null || d==undefined){\r\n                return;\r\n            }\r\n            if (d !== null && d !== \"\" && d.match(new RegExp(\"((0[1-9]|[12][0-9]|3[01])[/](0[1-9]|1[012])[/]((19|20)\\\\d\\\\d))\")) !== null && ui === 1) {\r\n                e = d.replace(new RegExp(\"((0[1-9]|[12][0-9]|3[01])[/](0[1-9]|1[012])[/]((19|20)\\\\d\\\\d))\"), \"$2-$3-$4\");\r\n                return e;\r\n            } else if (d !== null && d !== \"\" && d.match(new RegExp(\"((0[1-9]|[12][0-9]|3[01])[-](0[1-9]|1[012])[-]((19|20)\\\\d\\\\d))\")) !== null && ui === 0) {\r\n                e = d.replace(new RegExp(\"((0[1-9]|[12][0-9]|3[01])[-](0[1-9]|1[012])[-]((19|20)\\\\d\\\\d))\"), \"$2/$3/$4\");\r\n                return e;\r\n            } else {\r\n                return d;\r\n            }\r\n            };\r\n    \r\n        $scope.disable_btn = function (stat) {\r\n            if (shareData.fil_stat == 'FRZ' || shareData.fil_stat == 'FIL' || shareData.fil_stat == 'IP' || shareData.fil_stat == 'REC' || stat == 'IP' || stat == 'REC' || stat === 'FIL' || stat === 'FRZ') {\r\n                return true;\r\n            } else {\r\n                return false;\r\n            }\r\n        };\r\n        \r\n        $scope.disable_btn_file = function (stat) {\r\n            if (shareData.fil_stat === 'FIL' || shareData.fil_stat === 'IP' || shareData.fil_stat === 'REC' || stat==='FIL' || shareData.fil_stat == 'F') {\r\n                return true;\r\n            } else {\r\n                return false;\r\n            }\r\n        };\r\n        $scope.gstr2_disable_btn = function (stat) {\r\n            if (shareData.filing_stat == 'FRZ' || shareData.filing_stat == 'FIL' || stat == 'IP' || stat == 'REC') {\r\n                return true;\r\n            } else {\r\n                return false;\r\n            }\r\n        };\r\n    \r\n        $scope.disable_btn1 = function (stat) {\r\n            if (shareData.fil_stat == 'FRZ') {\r\n                return false;\r\n            } else {\r\n                return true;\r\n            }\r\n        };\r\n    \r\n        $scope.gstr2_disable_btn1 = function (stat) {\r\n            if (shareData.filing_stat == 'FRZ') {\r\n                return false;\r\n            } else {\r\n                return true;\r\n            }\r\n        };\r\n        \r\n        //GSTR5 Submit Disable Function \r\n        $scope.gstr5_disable_btn = function (stat) {\r\n            if (shareData.filing_stat == 'FRZ' || shareData.filing_stat == 'FIL' || stat == 'IP' || stat == 'REC') {\r\n                return true;\r\n            } else {\r\n                return false;\r\n            }\r\n        };\r\n    \r\n        //closes the confirmation modal which appears on clicking the delete button\r\n        $scope.destroyModal = function () {\r\n            utilFunctions._destroyDialogue();\r\n            $('body').css('padding-right', 0);\r\n        };\r\n    \r\n        $scope.checkItemAmount = function (item, supType) {\r\n            if (supType == 'Intra-State') {\r\n                if ((item.camt == 0 && item.crt == 0 && item.samt == 0 && item.srt == 0) || (item.camt > 0 && item.crt > 0 && item.samt > 0 && item.srt > 0)) {\r\n                    return true;\r\n    \r\n                } else {\r\n                    return false;\r\n                }\r\n            } else {\r\n                return true;\r\n            }\r\n        }\r\n    \r\n    \r\n        $rootScope.$on(\"CallGSTR\", function (event, res, gstr1type) {\r\n            shareData.rtn_prd = res.finYear;\r\n             shareData.fil_stat=res.status;\r\n           shareData.arnForItc=res.arn;\r\n           localStorage.setItem(\"BCK_FLAG\", \"E\");\r\n            localStorage.setItem(\"rtn_prd\", \"\"+shareData.rtn_prd);\r\n           if (gstr1type == 'GSTR1') {\r\n        \t   $window.location.href = '/returns/auth/gstr1';\r\n           }else if (gstr1type == 'GSTR1E') {\r\n               $location.path('auth/gstr1ex');\r\n           }\r\n            else if (gstr1type == 'GSTR2') {\r\n               $location.path('auth/gstr2');\r\n           } else if (gstr1type == 'GSTR3') {\r\n               $location.path('auth/gstr3');\r\n           } \r\n           else if (gstr1type == 'GSTR4') {\r\n              $window.location.href='/returns2/auth/gstr4';\r\n           }else if (gstr1type == 'GSTR5') {\r\n        \t   $window.location.href = '/returns/auth/gstr5';\r\n           } else if (gstr1type == 'GSTR2A') {\r\n               $location.path('auth/gstr2A');\r\n           } else if (gstr1type == 'GSTR8') {\r\n               $location.path('auth/gstr8');\r\n           } else if (gstr1type == 'GSTR6') {\r\n               $location.path('auth/gstr6');\r\n            } else if (gstr1type == 'GSTR7') {\r\n               $window.location.href='/returns2/auth/gstr7';\r\n            }else if (gstr1type == 'GSTR9') {\r\n                $window.location.href = '/returns2/auth/gstr9/dashboard';\r\n           }\r\n            else if (gstr1type == 'GSTR9A') {\r\n                $window.location.href='/returns2/auth/gstr9a';\r\n            }\r\n             else if (gstr1type == 'GSTR9C') {\r\n                $window.location.href = '/returns2/auth/gstr9c/dashboard';\r\n            }\r\n            else if (gstr1type == 'GSTR2X') {\r\n                localStorage.setItem('BCK_FLAG','EFILE');\r\n                $window.location.href = '/returns2/auth/gstr2x';\r\n            \r\n        }\r\n            else if (gstr1type == 'GSTR11') {\r\n               $window.location.href='/returns2/auth/gstr11';\r\n           }\r\n            else if (gstr1type == 'GSTR5A') {\r\n               localStorage.setItem(\"rtn_prd\", \"\"+shareData.rtn_prd);\r\n               localStorage.setItem(\"FILSTATUS\", shareData.fil_stat);\r\n                 $window.location.href=\"/returns2/auth/gstr5a\";\r\n               //$location.path('/returns2/auth/gstr5a');\r\n           } \r\n           else if (gstr1type == 'GSTR3B') {\r\n               var quarEnablePrd = $scope.servers.RTN_PROFILE_QOQ_SQ ? $scope.servers.RTN_PROFILE_QOQ_SQ : \"012021\";\r\n                var mon = Number(quarEnablePrd.substring(0, 2)) - 1;\r\n                var yr = Number(quarEnablePrd.substring(2, 6));\r\n                var gstr3BQuarterlyLiveDate = new Date(yr, mon);  // october 2020\r\n                var userRtnPrd = new Date(Number(shareData.rtn_prd.substring(2, 6)), Number(shareData.rtn_prd.substring(0, 2)) - 1);\r\n                var enableGstr3bQuarterly = userRtnPrd >= gstr3BQuarterlyLiveDate ? true : false;\r\n                localStorage.setItem(\"enableGstr3bQuarterly\", enableGstr3bQuarterly);\r\n                //$location.path('auth/gstr3b');\r\n                localStorage.setItem(\"GSTR3b_Info\", \"Y\");\r\n                // Setting up the user profile frequency\r\n                localStorage.setItem(\"uPref\", res.userPref);\r\n                var pref = (enableGstr3bQuarterly && res.userPref == \"Q\") ? \"Q\" : \"M\";\r\n                localStorage.setItem(\"gstr3bPref\", pref);\r\n                FormSubmitter.submit(\"auth/gstr3b\", \"POST\", {\r\n                    \"RTN_PRD\": shareData.rtn_prd\r\n                });\r\n           }\r\n           else if (gstr1type == 'TRAN1') {\r\n               $window.location.href='/returns/auth/transition/trans1';\r\n           }\r\n            else if (gstr1type == 'TRAN2') {\r\n                localStorage.setItem(\"tran2dashboardflag\",true);\r\n    \r\n            $window.location.href='/returns/auth/transition/trans2';\r\n           }\r\n            else if (gstr1type == 'TRAN3') {\r\n          $window.location.href='/returns/auth/transition/trans3';\r\n           }\r\n            else if (gstr1type == 'ITC01-18A') {\r\n              localStorage.setItem(\"ARNITC\",shareData.arnForItc+\"\");\r\n                localStorage.setItem(\"RETTYPEITC\",\"ITC01-18A\");\r\n                localStorage.setItem(\"FY\",res.fy+\"\");\r\n               $window.location.href='/returns2/auth/itcform/itc01summ';\r\n           }\r\n           else if (gstr1type == 'ITC01-18B') {\r\n               localStorage.setItem(\"ARNITC\",shareData.arnForItc+\"\");\r\n                localStorage.setItem(\"RETTYPEITC\",\"ITC01-18B\");\r\n               localStorage.setItem(\"FY\",res.fy+\"\");\r\n               $window.location.href='/returns2/auth/itcform/itc01summ';\r\n           }\r\n           else if (gstr1type == 'ITC01-18C') {\r\n               localStorage.setItem(\"ARNITC\",shareData.arnForItc+\"\");\r\n                localStorage.setItem(\"RETTYPEITC\",\"ITC01-18C\");\r\n               localStorage.setItem(\"FY\",res.fy+\"\");\r\n               $window.location.href='/returns2/auth/itcform/itc01summ';\r\n           }\r\n            else if (gstr1type == 'ITC01-18D') {\r\n                   localStorage.setItem(\"ARNITC\",shareData.arnForItc+\"\");\r\n                localStorage.setItem(\"RETTYPEITC\",\"ITC01-18D\");\r\n                localStorage.setItem(\"FY\",res.fy+\"\");\r\n               $window.location.href='/returns2/auth/itcform/itc01summ';\r\n           }\r\n            else if (gstr1type == 'ITC04') {\r\n               $window.location.href='/returns2/auth/itc04/selectquarter';\r\n           }\r\n            else if (gstr1type == 'ITC02') {\r\n               localStorage.setItem(\"ARNITC\",shareData.arnForItc+\"\");\r\n               localStorage.setItem(\"ITC02VIEWPATH\",\"true\");\r\n               $window.location.href='/returns2/auth/itc02/transfer';\r\n           }else if (gstr1type == 'ITC02A') {\r\n            sessionStorage.setItem(\"ARNITC\", shareData.arnForItc + \"\");\r\n            $window.location.href = '/returns2/auth/itc02a/transfer';\r\n        }\r\n             else if (gstr1type == 'ITC03-4A') {\r\n                localStorage.setItem(\"ARNITC\",shareData.arnForItc+\"\");\r\n                localStorage.setItem(\"RETTYPEITC\",\"ITC03-4A\");\r\n                $window.location.href='/returns2/auth/itc03/onlinepage';\r\n            }\r\n            else if (gstr1type == 'ITC03-4B') {\r\n                localStorage.setItem(\"ARNITC\",shareData.arnForItc+\"\");\r\n                localStorage.setItem(\"RETTYPEITC\",\"ITC03-4B\");\r\n                $window.location.href='/returns2/auth/itc03/onlinepage';\r\n            }\r\n            else if (gstr1type == 'GSTR10') {\r\n                localStorage.setItem(\"gstr10ret_period\",\"\" + shareData.rtn_prd);\r\n                $window.location.href='/returns2/auth/gstr10';\r\n            }\r\n            else if (gstr1type == 'CMP08') {\r\n                $window.location.href = '/returns2/auth/cmp08';\r\n            }else if (gstr1type == 'GSTR4X') {\r\n              \r\n                var url = $().getServers().GST_GSTR4_ANNUAL+\"/gstr4annual/auth/gstr4\";\r\n                var data= {\r\n                        rtnprd : shareData.rtn_prd\t\r\n                };\r\n                FormSubmitter.submit(url, \"POST\", data);\r\n            }\r\n\t\t\telse if(gstr1type == 'GSTR1A'){\r\n\t\t\t\tvar gstr1aurl = $().getServers().GST_RETURNS_R1A_URL + '/r1Aweb/auth/gstr1a';\r\n\t\t\t\tFormSubmitter.submit(gstr1aurl, \"POST\", {\r\n                'finyr': res.fy,\r\n                'rtn_prd': shareData.rtn_prd,\r\n                'uPref' : res.userPref,\r\n\t\t\t\t'BCK_FLAG' : 'E'\r\n            });\r\n\t\t\t}\r\n        });\r\n        $scope.historyback = function () {\r\n            window.history.back();\r\n        }\r\n    \r\n    $scope.checkdup = function (dupinv, secname, ctin, idtFy) {\r\n            var deferred = $q.defer();\r\n            var diff_prcnt = null;\r\n            if(ctin === 0.65){\r\n                diff_prcnt = 0.65;\r\n                ctin = null;\r\n            }\r\n            if (dupinv) {\r\n    \r\n                var urldat = {\r\n                    isExists: false,\r\n                    message: \"\",\r\n                    isCtinvalid: false\r\n                };\r\n                if (ctin) {\r\n                    \r\n                    ajax.get(\"auth/api/gstr1/userdetails?ctin=\" + ctin)\r\n                    .then(function (response) {\r\n                        if(response.status==1){\r\n                        urldat.isCtinvalid = true;\r\n                        }\r\n                    ...[truncated at 15000 chars]"

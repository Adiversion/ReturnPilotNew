          "content": {
            "size": 625654,
            "mimeType": "application/javascript",
            "text": "myApp.controller(\"pdfctrl\", [\r\n    \"$scope\",\r\n    \"$location\",\r\n    \"$rootScope\",\r\n    \"shareData\",\r\n    \"$timeout\",\r\n    \"$window\",\r\n    \"version\",\r\n    \"cache\",\r\n    \"ajax\",\r\n    \"$compile\",\r\n    \"$route\",\r\n    \"$http\",\r\n    \"validations\",\r\n    \"$log\",\r\n    \"utilFunctions\",\r\n    \"$q\",\r\n    \"$filter\",\r\n    function(\r\n        $scope,\r\n        $location,\r\n        $rootScope,\r\n        shareData,\r\n        $timeout,\r\n        $window,\r\n        version,\r\n        cache,\r\n        ajax,\r\n        $compile,\r\n        $route,\r\n        $http,\r\n        validations,\r\n        $log,\r\n        utilFunctions,\r\n        $q,\r\n        $filter\r\n    ) {\r\n        $scope.pdfScript = false;\r\n        if (cache.get(\"month\") && cache.get(\"month\").length > 0) {\r\n            var months = cache.get(\"month\");\r\n        } else {\r\n            ajax.get(\"/pages/returns/data/months.json\").then(\r\n                function(response) {\r\n                    $scope.months = response.Months;\r\n                    cache.set(\"month\", $scope.months);\r\n                },\r\n                function(err) {}\r\n            );\r\n        }\r\n        $scope.genratepdf_gstr4 = function(is_calc, formDetails) {\r\n            if (is_calc === \"CALC\") {\r\n                var status = \"RTF\";\r\n                $scope.main_page_gstin = formDetails.gstin;\r\n                $scope.bus_name = formDetails.bus_name;\r\n                $scope.trade_name = formDetails.trade_name;\r\n                var pdfname =\r\n                    \"GSTR4_\" + $scope.main_page_gstin + \"_\" + formDetails.fp + \"_SUMMARY\";\r\n            } else {\r\n                var status = $scope.fil_stat;\r\n                var prd_mon = shareData.rtn_prd.substring(0, 2);\r\n                var prd_year = shareData.rtn_prd.substring(2);\r\n\r\n                switch (prd_mon) {\r\n                    case \"13\":\r\n                        var pdf_prd = \"06\" + prd_year;\r\n                        break;\r\n                    case \"14\":\r\n                        var pdf_prd = \"09\" + prd_year;\r\n                        break;\r\n                    case \"15\":\r\n                        var pdf_prd = \"12\" + prd_year;\r\n                        break;\r\n                    case \"16\":\r\n                        var pdf_prd = \"03\" + (parseInt(prd_year) + 1).toString();\r\n                        break;\r\n                }\r\n                var pdfname = \"GSTR4_\" + $scope.main_page_gstin + \"_\" + pdf_prd;\r\n            }\r\n            var text = \" DRAFT  \";\r\n            if (status === \"FRZ\" || status === \"FIL\") {\r\n                var text = \"  FINAL  \";\r\n            }\r\n            if (is_calc === \"CALC\") {\r\n                var text = \"  SUMMARY  \";\r\n            }\r\n            var dd = {\r\n                pageSize: \"A4\",\r\n                pageOrientation: \"landscape\",\r\n                pageMargin: [40, 60, 40, 60],\r\n                watermark: {\r\n                    text: text,\r\n                    color: \"black\",\r\n                    opacity: 0.3,\r\n                    bold: true,\r\n                    italics: false,\r\n                    fontSize: 20,\r\n                },\r\n                content: [{\r\n                        text: is_calc === \"CALC\" ? \"Form GSTR4 (Summary)\" : \"Form GSTR-4\",\r\n                        style: \"header\",\r\n                    },\r\n                    {\r\n                        text: \"[See Rule 62]\",\r\n                        italics: true,\r\n                        style: \"rule\",\r\n                    },\r\n\r\n                    {\r\n                        text: \"Quarterly Return for registered person opting for composition levy\",\r\n                        bold: true,\r\n                        style: \"center\",\r\n                    },\r\n                    {\r\n                        text: is_calc === \"CALC\" ?\r\n                            \"\" :\r\n                            \"Note: Please ensure that figures shown in preview file are same as available in the summary sheet seen in Offline Tool. File only after viewing the Preview of this return(GSTR4).\",\r\n                    },\r\n                ],\r\n                styles: {\r\n                    header: {\r\n                        fontSize: 18,\r\n                        bold: true,\r\n                        margin: [300, 0, 0, 10],\r\n                    },\r\n                    subheader: {\r\n                        fontSize: 16,\r\n                        bold: true,\r\n                        margin: [0, 10, 0, 5],\r\n                    },\r\n                    tableExample: {\r\n                        margin: [0, 5, 0, 15],\r\n                    },\r\n                    retprd: {\r\n                        margin: [470, 0, 0, 10],\r\n                    },\r\n                    center: {\r\n                        margin: [200, 0, 0, 10],\r\n                    },\r\n                    tableHeader: {\r\n                        bold: true,\r\n                        fontSize: 13,\r\n                        color: \"black\",\r\n                    },\r\n                    rule: {\r\n                        margin: [315, 0, 0, 10],\r\n                    },\r\n                },\r\n            };\r\n            if (is_calc === \"CALC\") {\r\n                dd.content.push({\r\n                    style: \"retprd\",\r\n                    table: {\r\n                        widths: [\"30%\", \"auto\"],\r\n                        body: [\r\n                            [\"Financial Year\", formDetails.fy || \"-\"]\r\n                        ],\r\n                    },\r\n                });\r\n            } else {\r\n                dd.content.push({\r\n                    style: \"retprd\",\r\n                    table: {\r\n                        widths: [\"30%\", \"auto\"],\r\n                        body: [\r\n                            [\"Year\", $scope.finyr || \"-\"],\r\n                            [\"Quarter\", $scope.retprd || \"-\"],\r\n                        ],\r\n                    },\r\n                });\r\n            }\r\n            if (is_calc === \"CALC\") {\r\n                dd.content.push({\r\n                    style: \"tableExample\",\r\n                    table: {\r\n                        widths: [\"65%\", \"auto\"],\r\n                        body: [\r\n                            [\"1. GSTIN\", formDetails.gstin || \"-\"],\r\n                            [\r\n                                \"2(a). Legal name of the registered person\",\r\n                                formDetails.ln || \"-\",\r\n                            ],\r\n                            [\"2(b). Trade name, if any\", formDetails.tn || \"-\"],\r\n                        ],\r\n                    },\r\n                });\r\n            } else {\r\n                dd.content.push({\r\n                    style: \"tableExample\",\r\n                    table: {\r\n                        widths: [\"65%\", \"auto\"],\r\n                        body: [\r\n                            [\"1. GSTIN\", $scope.main_page_gstin || \"-\"],\r\n                            [\r\n                                \"2(a). Legal name of the registered person\",\r\n                                $scope.bus_name || \"-\",\r\n                            ],\r\n                            [\"2(b). Trade name, if any\", $scope.trade_name || \"-\"],\r\n                            [\"3. ARN\", $scope.arn_no || \"-\"],\r\n                            [\"4. Date of ARN\", $scope.fil_dt || \"-\"],\r\n                        ],\r\n                    },\r\n                }, {\r\n                    text: \"Note: All amounts displayed in the tables are in INR.\",\r\n                });\r\n            }\r\n            if ($scope.gstr4SumData.sec_sum.length > 0 && $scope.b2bamdat) {\r\n                dd.content.push({\r\n                    text: \"4A. Inward supplies received from a registered supplier (supplies excluding reverse charge)\",\r\n                    style: \"subheader\",\r\n                }, {\r\n                    style: \"tableExample\",\r\n                    table: {\r\n                        body: [\r\n                            [\r\n                                \"No. of Records\",\r\n                                \"Total Invoice value  (\\u20B9)\",\r\n                                \"Total Taxable value  (\\u20B9)\",\r\n                                \"Total Integrated Tax  (\\u20B9)\",\r\n                                \"Total Central Tax  (\\u20B9)\",\r\n                                \"Total State/UT  Tax  (\\u20B9)\",\r\n                                \"Total Cess  (\\u20B9)\",\r\n                            ],\r\n                            [\r\n                                $scope.b2bdat.ttl_non_rchrg.ttl_rec,\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_non_rchrg.ttl_val),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_non_rchrg.ttl_tax),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_non_rchrg.ttl_igst),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_non_rchrg.ttl_cgst),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_non_rchrg.ttl_sgst),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_non_rchrg.ttl_cess),\r\n                                    alignment: \"right\",\r\n                                },\r\n                            ],\r\n                        ],\r\n                    },\r\n                }, {\r\n                    text: \"4B. Inward supplies received from a registered supplier (supplies attracting reverse charge)\",\r\n                    style: \"subheader\",\r\n                }, {\r\n                    style: \"tableExample\",\r\n                    table: {\r\n                        body: [\r\n                            [\r\n                                \"No. of Records\",\r\n                                \"Total Invoice value (\\u20B9)\",\r\n                                \"Total Taxable value (\\u20B9)\",\r\n                                \"Total Integrated Tax (\\u20B9)\",\r\n                                \"Total Central Tax (\\u20B9)\",\r\n                                \"Total State/UT  Tax (\\u20B9)\",\r\n                                \"Total Cess (\\u20B9)\",\r\n                            ],\r\n                            [\r\n                                $scope.b2bdat.ttl_rchrg.ttl_rec,\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_rchrg.ttl_val),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_rchrg.ttl_tax),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_rchrg.ttl_igst),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_rchrg.ttl_cgst),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_rchrg.ttl_sgst),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2bdat.ttl_rchrg.ttl_cess),\r\n                                    alignment: \"right\",\r\n                                },\r\n                            ],\r\n                        ],\r\n                    },\r\n                }, {\r\n                    text: \"4C. Inward supplies received from unregistered supplier\",\r\n                    style: \"subheader\",\r\n                }, {\r\n                    style: \"tableExample\",\r\n                    table: {\r\n                        body: [\r\n                            [\r\n                                \"No. of Records\",\r\n                                \"Total Invoice value (\\u20B9)\",\r\n                                \"Total Taxable value (\\u20B9)\",\r\n                                \"Total Integrated Tax (\\u20B9)\",\r\n                                \"Total Central Tax (\\u20B9)\",\r\n                                \"Total State/UT  Tax (\\u20B9)\",\r\n                                \"Total Cess (\\u20B9)\",\r\n                            ],\r\n                            [\r\n                                $scope.b2burdat.ttl_rec,\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2burdat.ttl_val),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2burdat.ttl_tax),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2burdat.ttl_igst),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2burdat.ttl_cgst),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2burdat.ttl_sgst),\r\n                                    alignment: \"right\",\r\n                                },\r\n                                {\r\n                                    text: $filter(\"INR\")($scope.b2burdat.ttl_cess),\r\n                                    alignment: \"right\",\r\n                                },\r\n                            ],\r\n                        ],\r\n                    },\r\n                }, {\r\n                    text: \"4D. Import of service\",\r\n                    style: \"subheader\",\r\n                }, {\r\n                    style: \"tableExample\",\r\n                    table: {\r\n                        body: [\r\n                            [\r\n                                \"No. of Records\",\r\n                                \"Total Invoice value (\\u20B9)\",\r\n                                \"Total Taxable value (\\u20B9)\",\r\n                                \"Total Integrated Tax (\\u20B9)\",\r\n                                \"Total Cess (\\u20B9)\",\r\n                            ],\r\n                            [\r\n        ...[truncated at 15000 chars]"

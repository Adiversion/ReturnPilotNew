            "text": "<div class=\"f1 menuList\" data-ng-show=\"!expanded && !hidemenu\" id=\"siteDis\" data-toggle=\"tooltip\" data-placement=\"top\" data-ng-class=\"{'disabled' :udata.disableMenu}\">\r\n\t<div class=\"container\">\r\n\t\t<div class=\"row\">\r\n\t\t<div class=\"col-lg-2 col-md-2 col-sm-2 col-xs-12 no-mobile\">\r\n\t\t\t\t<a class=\"fhead\" ng-attr-target=\"{{(servers.STATIC_WEB === true) ? undefined : '_blank'}}\" data-ng-href=\"{{servers.GST_CONTENT_R1_URL}}/about/gst/history\" data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">About GST</a>\r\n\t\t\t\t<ul>\r\n\t\t\t\t    <!--<li><a ng-attr-target=\"{{(servers.STATIC_WEB === true) ? undefined : '_blank'}}\" data-ng-href=\"{{servers.GST_CONTENT_R1_URL}}/about/vision\">Vision and Mission</a></li>\r\n\t\t\t\t\t<li><a ng-attr-target=\"{{(servers.STATIC_WEB === true) ? undefined : '_blank'}}\" data-ng-href=\"{{servers.GST_CONTENT_R1_URL}}/about/citizencharter\">Citizen Charter</a></li>-->\r\n\t\t\t\t\t<li><a ng-attr-target=\"{{(servers.STATIC_WEB === true) ? undefined : '_blank'}}\" data-ng-href=\"{{servers.GST_CONTENT_R1_URL}}/about/gst/council\" data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">GST Council Structure</a></li>\r\n\t\t\t\t\t<li><a ng-attr-target=\"{{(servers.STATIC_WEB === true) ? undefined : '_blank'}}\" data-ng-href=\"{{servers.GST_CONTENT_R1_URL}}/about/gst/history\" data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">GST History</a></li>\r\n\t\t\t\t</ul>\t\t\t\t\r\n\t\t\t</div>\r\n\t\t\t<div class=\"col-lg-2 col-md-2 col-sm-2 col-xs-12 no-mobile\">\r\n\t\t\t\t<a class=\"fhead\" ng-attr-target=\"{{(servers.STATIC_WEB === true) ? undefined : '_blank'}}\" data-ng-href=\"{{servers.GST_CONTENT_R1_URL}}/policies/website\" data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">Website Policies</a>\r\n\t\t\t\t<ul>\r\n\t\t\t\t\t<li><a ng-attr-target=\"{{(servers.STATIC_WEB === true) ? undefined : '_blank'}}\" data-ng-href=\"{{servers.GST_CONTENT_R1_URL}}/policies/website\" dat
            "mimeType": "application/javascript",
            "text": "myApp.controller(\"gstrcompctrl\",gstrcompctrl);\r\n\r\ngstrcompctrl.$inject = ['$scope', '$location', '$rootScope', 'shareData', '$window','ajax','$route','NgTableParams','utilFunctions', '$compile','validations','$timeout','FormSubmitter','$filter','exceljs','filesaver','emblem','constants'];\r\n\r\n\r\nfunction gstrcompctrl($scope,$location,$rootScope,shareData,$window,ajax,$route,NgTableParams,utilFunctions, $compile,validations,$timeout,FormSubmitter,$filter,exceljs,filesaver,emblem,constants){\r\n//page navigation\r\nif($().getConstant(\"rtn_prd\")){\r\n\tlocalStorage.setItem('rtn_prd',$().getConstant(\"rtn_prd\"));\r\n}\r\nif($().getConstant(\"bck_flag\")){\r\n\tlocalStorage.setItem('BCK_FLAG',$().getConstant(\"bck_flag\"));\r\n}\r\nif($().getConstant(\"formname\")){\r\n\tlocalStorage.setItem('formname',$().getConstant(\"formname\"));\r\n}\r\n$scope.goToPage = function(path){\r\n\t\t$location.path(path);\r\n\t}\r\n\r\n$scope.itcshow = false;\r\n\t$scope.itcTable = function(){\r\n\t\t$scope.itcshow = true;\r\n\t}\r\n//toggler for accordion\r\n$(document).on('click', \".plustoggler\", function () {\r\n\t$(this).find('span.fa').toggleClass('fa-plus fa-minus');\r\n});\r\n\t$scope.collapseAll=true;\r\n\t$scope.collapseColA=true;\r\n\t$scope.collapseColB=true;\r\n\t$scope.collapseColC=true;\r\n\t$scope.collapseColD=true;\r\n\t$scope.collapseColE=true;\r\n\tconsole.log(\"tableg=\",$scope.tableg)\r\n\t$scope.toggleCollapseAll= function(){\r\n\t\t$scope.collapseAll= !$scope.collapseAll;\r\n\t\tif($scope.collapseAll){\r\n\t\t\t$scope.collapseColA=true;\r\n\t\t\t$scope.collapseColB=true;\r\n\t\t\t$scope.collapseColC=true;\r\n\t\t\t$scope.collapseColD=true;\r\n\t\t\t$scope.collapseColE=true;\r\n\t\t}\r\n\t\telse{\r\n\t\t\t$scope.collapseColA=false;\r\n\t\t\t$scope.collapseColB=false;\r\n\t\t\t$scope.collapseColC=false;\r\n\t\t\t$scope.collapseColD=false;\r\n\t\t\t$scope.collapseColE=false;\r\n\t\t}\r\n\t}\r\n\t$scope.toggleCollapseColA= function(){\r\n\t\tconsole.log(\"clicked A\");\r\n\t\t$scope.collapseColA= !$scope.collapseColA;\r\n\t}\r\n\t$scope.toggleCollapseColB= function(){\r\n\t\t$scope.collapseColB= !$scope.collapseColB;\r\n\t}\r\n\t$scope.toggleCollapseColC= function(){\r\n\t\t$scope.collapseColC= !$scope.collapseColC;\r\n\t}\r\n\t$scope.toggleCollapseColD= function(){\r\n\t\t$scope.collapseColD= !$scope.collapseColD;\r\n\t}\r\n\t$scope.toggleCollapseColE= function(){\r\n\t\t$scope.collapseColE= !$scope.collapseColE;\r\n\t}\r\n       \r\n\t$scope.setTaxperiodModal= function(taxPeriod){\r\n\t\tif(taxPeriod != 'Total'){\r\n\t\tconst selectedTaxPeriodDetails=$scope.datagstr3b_tabg.filter(function(el){\r\n\t\t\tif(el.taxPeriod === taxPeriod && el.drc_liability !== undefined && el.drc_liability.total !== undefined ) \r\n\t\t\t\treturn true;\r\n\t\t\telse  false;\r\n\t\t})\r\n\t\tif(selectedTaxPeriodDetails !== undefined )\r\n\t\t\t$scope.selectedDrcLiabilityDetails= selectedTaxPeriodDetails[0].drc_liability.details;\r\n\t\t// $('#ShowDetailsModal').modal('show');\r\n\t\t$(\"#ShowDetailsModal\").modal({ backdrop: 'static', keyboard: false });\r\n\t\t}\r\n\t}\r\n\r\n//Comparison changes-getting admin web property\r\n$scope.servers = $().getServers();\r\n    if ($().getConstant($scope.trans.COMP_REPORT_FLAG)) {\r\n        $scope.compFlag = $().getConstant($scope.trans.COMP_REPORT_FLAG);\r\n\t}\r\n\t//CR28952\r\n\t//Comparison changes end here\r\n\tutilFunctions._destroyDialogue();\r\n\t\t//getting date  \r\n\tvar dt = new Date();\r\n\tvar yr = localStorage.getItem('fin_year').slice(0, 4);\t\r\n\r\n\t$scope.r1a_start_date =$().getConstant(\"GSTR1A_START_DATE\");\r\n\t$scope.isR1alive = (yr >= ((Number($scope.r1a_start_date.split('-')[1]) <=3) ? ($scope.r1a_start_date.split('-')[2] - 1) : $scope.r1a_start_date.split('-')[2])) ? true : false;\r\n\tif($().getConstant(\"R1_NEW_ECO_STRT_PRD\")) {\r\n\t\t$scope.ecoStartPrd = $().getConstant(\"R1_NEW_ECO_STRT_PRD\");\r\n\t\t$scope.ecoEnabledPrd = Number($scope.ecoStartPrd.substring(0,2))< 4 ? Number($scope.ecoStartPrd.substring(2))-1 : Number($scope.ecoStartPrd.substring(2));\r\n\r\n\t\t$scope.ecoEnabled = (yr >= $scope.ecoEnabledPrd ? true : false);\r\n\t}\r\n\r\n\t// configuration done for amount declared in production period\r\n\t$scope.prdFinYear = $().getConstant(\"R1_PROD_AMOUNT_PRD\");\r\n\t$scope.prdFinYearEnabled = (yr >= $scope.prdFinYear ? true : false);\r\n\r\n\t//CR21773 changes start\r\n\t$scope.gstr3bnegval_transyear = false;\r\n\t$scope.gstr3bnegval_newcalc  = false;\r\n\tvar settlementStartPrd = $scope.servers.SETL_1_06_STRT_PRD;\r\n\tvar tempChangeYr = Number(settlementStartPrd.substring(0,2))< 4 ? Number(settlementStartPrd.substring(2))-1:Number(settlementStartPrd.substring(2));\r\n\tif(yr == tempChangeYr){\r\n\t\t$scope.gstr3bnegval_transyear = true;\r\n\t\t$scope.gstr3bnegval_newcalc  = false;\r\n\t}\r\n    else if(yr > tempChangeYr){\r\n        $scope.gstr3bnegval_newcalc  = true;\r\n\t\t$scope.gstr3bnegval_transyear = false;\r\n    }\r\n\telse{\r\n\t\t$scope.gstr3bnegval_newcalc  = false;\r\n\t\t$scope.gstr3bnegval_transyear = false;\r\n\t}\r\n\t//CR-18639 - changes starts here\r\n\t$scope.navigateDRC = function(){\r\n\t\twindow.location.href = $scope.servers.GST_SERVICES_R1_URL + \"/litserv/auth/case/search\";\r\n\t}\r\n\r\n\tif($().getConstant(constants.IFF_GO_LIVE_RTN_PRD) && ($scope.isIFFprd == undefined)){\t\t\t\r\n\t\tvar IFFEnabled = $().getConstant(constants.IFF_GO_LIVE_RTN_PRD);\r\n\t\tvar IffPrdfet =   Number(IFFEnabled.slice(0,2)); \r\n\t\tvar iffFy= Number(IFFEnabled.slice(2));   \r\n\t\tif(IffPrdfet<=3){\r\n\t\t\tvar yr1 = Number(yr.slice(2)) + 1; \r\n\t\t\tvar iffFy1= Number(IFFEnabled.slice(4));\r\n\t\t\t$scope.isIFFprd = (yr >= iffFy || yr1>=iffFy1) ? true : false;\r\n\t\t}\r\n\t\telse{\r\n\t\t\t$scope.isIFFprd = (yr >= iffFy ) ? true : false;\r\n\t\t}\r\n\t}\r\n\t//CR-18639 - changes ened here\r\n//change column header based on flag\r\n$scope.loadColumnsHeaders = function(tblType, hFlag){\r\n\tswitch(tblType){\r\n\t\tcase \"tableb\":\r\n\t\t\tif(hFlag==\"0\"){\r\n\t\t\t\t$scope.LBL_AMT_GSTR2A = $scope.trans.LBL_AMT_GSTR2A_NEW;\r\n\t\t\t\t$scope.LBL_SHORTFALL_EXCESS_3BVS2A = $scope.trans.LBL_SHORTFALL_EXCESS_3BVS2A_NEW;\r\n\t\t\t\t$scope.LBL_CUMULATIVE_SHORTFALL_3BVS2A = $scope.trans.LBL_CUMULATIVE_SHORTFALL_3BVS2A_NEW;\r\n\t\t\t\t//percentage column for table b 3b-2a\r\n\t\t\t\t$scope.LBL_CUMULATIVE_SHORTFALL_3BVS2A_NEW_PERCENT = \r\n\t\t\t\t$scope.trans.LBL_CUMULATIVE_SHORTFALL_3BVS2A_PERCENT;\r\n\r\n\t\t\t}\r\n\t\t\telse if (hFlag==\"1\"){\r\n\t\t\t\t$scope.LBL_AMT_GSTR2A = $scope.trans.LBL_AMT_GSTR2A_2B_NEW;\r\n\t\t\t\t$scope.LBL_SHORTFALL_EXCESS_3BVS2A = $scope.trans.LBL_SHORTFALL_EXCESS_3BVS2A_2B_NEW;\r\n\t\t\t\t$scope.LBL_CUMULATIVE_SHORTFALL_3BVS2A = $scope.trans.LBL_CUMULATIVE_SHORTFALL_3BVS2A_2B_NEW;\r\n\t\t\t\t//percentage column for table b 2a/2b\r\n\t\t\t\t$scope.LBL_CUMULATIVE_SHORTFALL_3BVS2A_NEW_PERCENT = \r\n\t\t\t\t$scope.trans.LBL_CUMULATIVE_SHORTFALL_3BVS2A_2B_PRCNT;\r\n\t\t\t\t}\r\n\t\t\telse{\r\n\t\t\t\t$scope.LBL_AMT_GSTR2A = $scope.trans.LBL_AMT_GSTR2B_NEW;\r\n\t\t\t\t$scope.LBL_SHORTFALL_EXCESS_3BVS2A = $scope.trans.LBL_SHORTFALL_EXCESS_3BVS2B_NEW;\r\n\t\t\t\t$scope.LBL_CUMULATIVE_SHORTFALL_3BVS2A = $scope.trans.LBL_CUMULATIVE_SHORTFALL_3BVS2B_NEW;\r\n\t\t\t\t//percentage column for table b 2b\r\n\t\t\t\t$scope.LBL_CUMULATIVE_SHORTFALL_3BVS2A_NEW_PERCENT = $scope.trans.LBL_CUMULATIVE_SHORTFALL_3BVS2B_NEW_PERCENT;\r\n\t\t\t}\r\n\t\tbreak;\r\n\t\tcase \"tabled\":\r\n\t\t\tif(hFlag==\"0\"){\r\n\t\t\t\t$scope.LBL_ITC_GSTR2A = $scope.trans.LBL_ITC_GSTR2A_NEW;\r\n\t\t\t\t$scope.LBL_SHORTFALL_EXCESS_3BVS2A_ITC = $scope.trans.LBL_SHORTFALL_EXCESS_3BVS2A_ITC_NEW;\r\n\t\t\t\t$scope.LBL_CUMULATIVE_SHORTFALL_3BVS2A_ITC = $scope.trans.LBL_CUMULATIVE_SHORTFALL_3BVS2A_ITC_NEW;\r\n\t\t\t\t//percentage column for table 4  3b-2a as prcnt\r\n\t\t\t\t$scope.LBL_CUMULATIVE_SHORTFALL_3BVS2B_ITC_NEW_PERCENT = \r\n\t\t\t\t$scope.trans.LBL_CUMULATIV
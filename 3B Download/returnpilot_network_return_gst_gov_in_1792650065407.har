            "size": 414623,
            "mimeType": "application/javascript",
            "text": "/*jslint browser: true*/\r\n/*global $, jQuery, angular*/\r\n/*   @author:    Mohammed Aftab, Amrita Dubey, Shruti Kiranagi,Manali Reddy\r\n    @created:   Sep-Nov 2016\r\n    @description: \r\n    @description: this is for \"Credit/Debit Notes\"\t\r\n    @copyright: (c) Copyright by Infosys technologies\r\n  */\r\n'use strict';\r\nvar myApp = angular.module(\"myApp\", ['ngRoute', 'LocalStorageModule', 'ngProgress','ngTable','angularjs-dropdown-multiselect']);\r\nmyApp.value('version', \"1.1\");\r\nmyApp.value('servers', true);\r\nmyApp.config(function($logProvider, $provide){\r\n\r\n    // $logProvider.debugEnabled(true);\r\n    var EnableLog = true;\r\n\r\n    $provide.decorator('$log', function ($delegate) {\r\n        //Original methods\r\n        var origInfo = $delegate.info;\r\n        var origLog = $delegate.log;\r\n\r\n        //Override the default behavior\r\n        var logTypes = ['log', 'warn', 'info', 'error', 'debug'],\r\n            logTypLen = logTypes.length;\r\n\r\n        for(var i=0;i<logTypLen;i++){\r\n            $delegate[logTypes[i]] = function () {\r\n                if (EnableLog)\r\n                origInfo.apply(null, arguments)\r\n            };\r\n        }\r\n\r\n        return $delegate;\r\n    });\r\n});\r\n//maintrunk\r\nvar RouteProviderConfig = function ($routeProvider, $locationProvider) {\r\n    var returnVerion = $().getConstant('GST_RETURN_VER');\r\n\tvar ServiceURL =$().getServers().GST_SERVICES_R1_URL;\r\n    if($().getConstant('IFF_GO_LIVE_RTN_PRD')){\r\n        var IFFEnabled = $().getConstant('IFF_GO_LIVE_RTN_PRD');\r\n        var IFFret_period=localStorage.getItem('rtn_prd');\r\n        var Iff_go_live_prd = localStorage.getItem('IFF_GO_LIVE_PRD');\r\n        if(Iff_go_live_prd == null && IFFret_period != null){\r\n            IFFEnabled = Number(IFFEnabled.substring(2)+IFFEnabled.substring(0,2));\r\n            var IFFreturnperiod = Number(IFFret_period.substring(2)+IFFret_period.substring(0,2))\r\n            if(IFFreturnperiod>=IFFEnabled)\r\n            localStorage.setItem('IFF_GO_LIVE_PRD',true);\r\n            else localStorage.setItem('IFF_GO_LIVE_PRD',false);\r\n        }\r\n        var Iff_go_live_prd = localStorage.getItem('IFF_GO_LIVE_PRD');\r\n    }\r\n    $routeProvider\r\n    \r\n    /*********************************************************GSTR-1********************************************************************/\r\n       \r\n        .when('/auth/dashboard', {\r\n            templateUrl: '/pages/returns/dashboard.html',\r\n            controller: 'dashboardcrtl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            }]\r\n        }).when('/auth/gstr/ewbofflinedownload', {\r\n            templateUrl: '/pages/returns/ewb/ewbdownload.html',\r\n            controller: 'gstr1Ewbctrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            }, {\r\n                \"n\": \"EWBGSTR-1\",\r\n                \"u\": \"\"\r\n            }]\r\n        }).when('/auth/finalreturn',{\r\n            templateUrl:'/pages/returns/finalreturn.html',\r\n            controller:'gstr10ctrl',\r\n            bc: [{\r\n                \"n\": \"Final Return\",\r\n                \"u\": \"returns/auth/finalreturn\"\r\n            }]\r\n        }).when('/auth/annualreturn',{\r\n            templateUrl:'/pages/returns/annualreturn.html',\r\n            controller:'annualdashboardcrtl',\r\n            bc: [{\r\n                \"n\": \"Annual Return\",\r\n                \"u\": \"returns2/auth/annualreturn\"\r\n            }]\r\n         }).when('/auth/obdeclaration',{//CR-21773B\r\n        templateUrl:'/pages/returns/openingbaldeclaration.html',\r\n        controller:'opnbalctrl',\r\n          bc: [{\r\n              \"n\": \"Opening Balance Declaration\",\r\n              \"u\": \"\"\r\n          }]\r\n        }).when('/auth/comparison', {\r\n            templateUrl: '/pages/returns/gstrcomp/comparison.html',\r\n            controller: 'dashboardcrtl',\r\n            bc: [{\r\n                \"n\": \"Tax liabilities and ITC comparison\",\r\n                \"u\": \"returns/auth/comparison\"\r\n            }]\r\n        }).when('/auth/rcmobdeclaration', { //CR-26198\r\n            templateUrl: '/pages/returns/rcmopeningbaldeclaration.html',\r\n            controller: 'rcmopnbalctrl',\r\n            bc: [{\r\n                \"n\": \"RCM ITC Opening Balance Declaration\",\r\n                \"u\": \"\"\r\n            }]\r\n        }).when('/auth/menucomp',{\r\n            templateUrl:'/pages/returns/gstrcomp/menu.html',\r\n            controller:'gstrcompctrl',\r\n\t\t\tbc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            },{\r\n                \"n\": \"Tax liabilities and ITC comparison\",\r\n                \"u\": \"\"\r\n            }]  \r\n        })\r\n\t\t.when('/auth/gstr3v1/liabsez', {\r\n            templateUrl: '/pages/returns/gstrcomp/liabsez.html',\r\n            controller: 'gstrcompctrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            }, {\r\n                \"n\": \"Liability other than Export/Reverse charge\",\r\n                \"u\": \"\"\r\n            }]\r\n        })\r\n\t\t.when('/auth/gstr3v1/liability', {\r\n            templateUrl: '/pages/returns/gstrcomp/liability.html',\r\n            controller: 'gstrcompctrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            }, {\r\n                \"n\": \"Liability due to Reverse charge\",\r\n                \"u\": \"\"\r\n            }]\r\n        })\r\n\t\t.when('/auth/gstr3v1/itccredit', {\r\n            templateUrl: '/pages/returns/gstrcomp/itccredit.html',\r\n            controller: 'gstrcompctrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            }, {\r\n                \"n\": \"ITC credit claimed and due\",\r\n                \"u\": \"\"\r\n            }]\r\n        })\r\n\t\t.when('/auth/gstr3v1/export', {\r\n            templateUrl: '/pages/returns/gstrcomp/export.html',\r\n            controller: 'gstrcompctrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            }, {\r\n                \"n\": \"Liability due to Export and SEZ Supplies\",\r\n                \"u\": \"\"\r\n            }]\r\n        })\r\n\t\t.when('/auth/file', {\r\n            templateUrl: '/pages/returns/file.html',\r\n            controller: 'filectrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            },{\r\n                \"n\": \"File\",\r\n                \"u\": \"\"\r\n            }]\r\n        }).when('/auth/itc04/file', {\r\n            templateUrl: '/pages/returns/itc/filing.html',\r\n            controller: 'filectrl',\r\n           bc: [{\t\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            },{\r\n                \"n\": \"GST ITC Forms\",\r\n                \"u\": \"returns2/auth/itcform/links\"\r\n            },{\r\n                \"n\": \"GST ITC-04\",\r\n                \"u\": \"returns2/auth/itc04/selectquarter\"\r\n            }]\r\n        }).when('/auth/itc03/file', {\r\n            templateUrl: '/pages/returns/itc/itc03/file.html',\r\n            controller: 'itc03filectrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            },{\r\n                \"n\": \"File\",\r\n                \"u\": \"\"\r\n            }]\r\n        }).when('/auth/gstr1', {\r\n            templateUrl: (returnVerion == 'V1') ?'/pages/returns/gstr1/summaryv3.html'\r\n\t\t\t\t\t\t\t\t\t\t\t:'/pages/returns/gstr1/summaryv3.html',\r\n            controller: 'gstr1summctrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            },{\r\n                \"n\": Iff_go_live_prd==\"true\" ? \"GSTR-1/IFF\":'GSTR-1',\r\n                \"u\": \"\"\r\n            }]\r\n        }).when('/auth/ledger/summary', {\r\n            templateUrl: '/pages/returns/ledger/electroniclearsummaryledgerl.html',\r\n            controller: 'ledctrl1',\r\n            bc: [{ \"n\": \"Ledger\", \"u\": \"Home\" }]\r\n\r\n\r\n        })\r\n        .when('/auth/ledger/provitc', {\r\n            templateUrl: '/pages/returns/ledger/provisionalitcledger.html',\r\n            controller: 'ledctrl1',\r\n            bc: [{ \"n\": \"Provisional Credit Balance\", \"u\": \"Home\" }]\r\n\r\n        }).when('/auth/ledger/blockedcreditledger', {\r\n            templateUrl: '/pages/returns/ledger/blockedcreditledger.html',\r\n            controller: 'ledctrl2',\r\n            bc: [{ \"n\": \"Blocked Credit Balance\", \"u\": \"Home\" }]\r\n\r\n        }).when('/auth/ledger/detailedledger', {\r\n\r\n            templateUrl: '/pages/returns/ledger/electronicleardetailedledger2.html',\r\n            controller: 'ledctrl1',\r\n            bc: [{ \"n\": \"Electronic Credit Ledger\", \"u\": \"\" }]\r\n\r\n        })\r\n\t\t .when('/auth/gstr/offlineupload', {\r\n            templateUrl: '/pages/returns/offline.html',\r\n            controller: 'gstrofflinectrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            },{\r\n                \"n\": \"GSTR\",\r\n                \"u\": \"\"\r\n            }]\r\n            })\r\n            \r\n\r\n\r\n\r\n                    /************************************************\r\n                      unbarringReturns\r\n         ****************************************************/\r\n                    //CR26286_ unbarringReturns start\r\n                    \r\n .when('/auth/unbarringreturns/alreadyraisedreq', {\r\n    templateUrl: '/pages/returns/unbarring-returns/alreadyraisedreq.html',\r\n    controller: 'unbarringReturnsctrl',\r\n    bc: [{\r\n        \"n\": \"Services\",\r\n        \"u\": ServiceURL + \"/services/auth/quicklinks/services\"\r\n    }, {\r\n        \"n\": \"Returns\",\r\n        \"u\": \"returns/auth/dashboard\"\r\n    }, {\r\n        \"n\": \"Application for Unbarring Returns\",\r\n        \"u\": \"returns2/auth/unbarringreturns/alreadyraisedreq\"\r\n    }, {\r\n        \"n\": \"Already Raised Request\",\r\n        \"u\": \"\"\r\n    }]\r\n})\r\n.when('/auth/unbarringreturns/raisenewreq', {\r\n    templateUrl: '/pages/returns/unbarring-returns/raisenewreq.html',\r\n    controller: 'unbarringReturnsctrl',\r\n    bc: [{\r\n        \"n\": \"Services\",\r\n        \"u\": ServiceURL + \"/services/auth/quicklinks/services\"\r\n    }, {\r\n        \"n\": \"Returns\",\r\n        \"u\": \"returns/auth/dashboard\"\r\n    }, {\r\n        \"n\": \"Application for Unbarring Returns\",\r\n        \"u\": \"returns2/auth/unbarringreturns/alreadyraisedreq\"\r\n    }, {\r\n        \"n\": \"Raise New Request\",\r\n        \"u\": \"\"\r\n    }]\r\n})\r\n .when('/auth/unbarringreturns/applstatus', {\r\n    templateUrl: '/pages/returns/unbarring-returns/applstatus.html',\r\n    controller: 'unbarringReturnsctrl',\r\n    bc: [{\r\n        \"n\": \"Services\",\r\n        \"u\": ServiceURL + \"/services/auth/quicklinks/services\"\r\n    },{\r\n        \"n\": \"Returns\",\r\n        \"u\": \"returns/auth/dashboard\"\r\n    }, {\r\n        \"n\": \"Application for Unbarring Returns\",\r\n        \"u\": \"returns2/auth/unbarringreturns/alreadyraisedreq\"\r\n    }, {\r\n        \"n\": \"Already Raised Request\",\r\n        \"u\": \"\"\r\n    }]\r\n})\r\n.when('/auth/unbarringreturns/appltype', {\r\n    templateUrl: '/pages/returns/unbarring-returns/appltype.html',\r\n    controller: 'unbarringReturnsctrl',\r\n    bc: [{\r\n        \"n\": \"Services\",\r\n        \"u\": ServiceURL + \"/services/auth/quicklinks/services\"\r\n    },{\r\n        \"n\": \"Returns\",\r\n        \"u\": \"returns/auth/dashboard\"\r\n    }, {\r\n        \"n\": \"Application for Unbarring Returns\",\r\n        \"u\": \"returns2/auth/unbarringreturns/alreadyraisedreq\"\r\n    }, {\r\n        \"n\": \"Already Raised Request\",\r\n        \"u\": \"\"\r\n    }]\r\n})\r\n\r\n.when('/auth/unblockgstinAck/foview', {\r\n    templateUrl: '/pages/returns/unbarring-returns/unbarringreturnsACK.html',\r\n    controller: 'unbarringReturnsAckCtrl',\r\n    bc: [{\r\n        \"n\": \"Services\",\r\n        \"u\": ServiceURL + \"/services/auth/quicklinks/services\"\r\n    },{\r\n        \"n\": \"Returns\",\r\n        \"u\": \"returns/auth/dashboard\"\r\n    }, {\r\n        \"n\": \"Application for Unbarring Returns\",\r\n        \"u\": \"returns2/auth/unbarringreturns/alreadyraisedreq\"\r\n    }, {\r\n        \"n\": \"Already Raised Request\",\r\n        \"u\": \"\"\r\n    }]\r\n})\r\n//CR26286_unbarringReturns changes end\r\n\r\n            //RQM28025  start\r\n            .when('/auth/gstr6/offlineupload', {\r\n            templateUrl: '/pages/returns/offline.html',\r\n            controller: 'gstrofflinectrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            },{\r\n                \"n\": \"GSTR-6\",\r\n                \"u\": \"\"\r\n            }]\r\n            })\r\n\r\n\t\t .when('/auth/gstr6a/offlineupload', {\r\n            templateUrl: '/pages/returns/offline.html',\r\n            controller: 'gstrofflinectrl',\r\n            bc: [{\r\n                \"n\": \"Returns\",\r\n                \"u\": \"returns/auth/dashboard\"\r\n            },{\r\n                \"n\": \"GSTR-6A\",\r\n                \"u\": \"\"\r\n            }]\r\n            }
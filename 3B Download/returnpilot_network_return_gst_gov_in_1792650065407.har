          "content": {
            "size": 77235,
            "mimeType": "application/javascript",
            "text": "// CR 23810 Spike Engine\r\n\"use strict\";\r\n\r\nmyApp.controller(\"drc01bCtrl\", [\r\n  \"$scope\",\r\n  \"$location\",\r\n  \"$rootScope\",\r\n  \"shareData\",\r\n  \"$timeout\",\r\n  \"$window\",\r\n  \"version\",\r\n  \"cache\",\r\n  \"ajax\",\r\n  \"$compile\",\r\n  \"$route\",\r\n  \"$http\",\r\n  \"$filter\",\r\n  \"$log\",\r\n  \"utilFunctions\",\r\n  \"FormSubmitter\",\r\n  \"NgTableParams\",\r\n  function (\r\n    $scope,\r\n    $location,\r\n    $rootScope,\r\n    shareData,\r\n    $timeout,\r\n    $window,\r\n    version,\r\n    cache,\r\n    ajax,\r\n    $compile,\r\n    $route,\r\n    $http,\r\n    $filter,\r\n    $log,\r\n    utilFunctions,\r\n    FormSubmitter,\r\n    NgTableParams\r\n  ) {\r\n    sessionStorage.clear();\r\n\r\n    utilFunctions.initCache();\r\n    $scope.servers = $().getServers();\r\n    $scope.trans = utilFunctions.initLanguage(\"returns\");\r\n    $rootScope.$on(\"LangChanged\", function (event, mass) {\r\n      $scope.trans = utilFunctions.initLanguage(\"returns\");\r\n    });\r\n\r\n    $scope.drc01bFlag = true;\r\n    $scope.initDrc = function () {\r\n      $scope.drc01bFlag = true;\r\n      $scope.errormessage = false;\r\n      $scope.disableFile = true;\r\n      $scope.drcChangeFlag = false;\r\n      $scope.inpValidation();\r\n      $scope.searchParams = { \"gstin\": \"\", \"refNo\": \"\", \"fy\": \"\", \"txPrd\": \"\", \"status\": \"PEN\", \"form_typ\": \"DRC01B\" };\r\n      $scope.arnValuesOnload(0);\r\n      $scope.drc03ArnValues = [];\r\n      if (shareData.drc01bFlag) {\r\n        $scope.drc01B = \"true\";\r\n        $scope.clickArn(shareData.dataDetail);\r\n      }\r\n      $scope.drc03WrnMsg = false;\r\n      $scope.deletedDrc03Arn = [];\r\n      $scope.deletedDrc03Array = [];\r\n      $scope.finalDrc03Array = [];\r\n      $scope.drc03Resp = [];\r\n      $scope.drc03ArnList = [];\r\n      $scope.drcDeleteFlag = false;\r\n      $scope.drcFlag = false;\r\n    };\r\n\r\n    // ***************** DRC01B Block 1 Starts from here ***************\r\n\r\n    // hardCoded ARN Values\r\n    $scope.getFY = function () {\r\n      $().blockPage(true);\r\n      var url = $scope.servers[\"GST_RETURNS_R1_URL\"] + \"/spikeweb/auth/web/dropdown\";\r\n      ajax.get(url).then(function (response) {\r\n        $().blockPage(false);\r\n        if (response.status === 1) {\r\n          $scope.dropdownYr = response.data.Years;\r\n          $scope.finYears = [];\r\n          for (var i = 0; i < response.data.Years.length; i++) {\r\n            $scope.finYears.push(response.data.Years[i].year.trim());\r\n          }\r\n          $scope.finYears.sort(function (a, b) {\r\n            return parseInt(b.substring(0, 4)) - parseInt(a.substring(0, 4))\r\n          });\r\n        }\r\n      }, function (response) {\r\n        $scope.errMsg = $scope.trans.DRC01B_SYSTEM_ERR_MSG;\r\n      });\r\n      //End\r\n\r\n    }\r\n\r\n    $scope.changeFY = function (fy) {\r\n      $scope.rtrnPeriods = [];\r\n      var selectedFY = [];\r\n      var fyr = fy.replaceAll(/\\s+/g, '');\r\n      for (var j = 0; j < $scope.dropdownYr.length; j++) {\r\n        if ($scope.dropdownYr[j].year === fyr) {\r\n          selectedFY = $scope.dropdownYr[j];\r\n        }\r\n      }\r\n      for (var i = 0; i < selectedFY.months.length; i++) {\r\n        $scope.rtrnPeriods.push(selectedFY.months[i].month);\r\n      }\r\n    }\r\n\r\n    $scope.arnValuesOnload = function (val) {\r\n      var month = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\r\n      $scope.myVar = \"\";\r\n      $scope.hidtab = false;\r\n      $().blockPage(true);\r\n      var url = $scope.servers[\"GST_RETURNS_R1_URL\"] + \"/spikeweb/auth/web/getArnList\";\r\n      ajax.get(url, $scope.searchParams).then(function (resp) {\r\n        $scope.myVar = null;\r\n        $scope.hidtab = true;\r\n\r\n        $().blockPage(false);\r\n        if (resp.status === 1) {\r\n          $scope.errormessage = false;\r\n          if (resp.data) {\r\n            var arnData = resp.data;\r\n            $scope.arnValues = [];\r\n            if (arnData.length > 0) {\r\n              for (var i = 0; i < arnData.length; i++) {\r\n                var fm = parseInt(arnData[i].rtnPrd.substring(0, 2));\r\n                var fy = arnData[i].rtnPrd.substring(2);\r\n                $scope.arnValues.push({\r\n                  \"refId\": arnData[i].refId,\r\n                  \"FormType\": $scope.trans.DRC01B_FORM_TYPE,\r\n                  \"ReturnPeriod\": month[fm - 1],\r\n                  \"FinancialYear\": (fm > 3) ? (fy + \"-\" + (parseInt(fy.substring(2)) + 1)) : (fy - 1) + \"-\" + (fy.substring(2)),\r\n                  \"Status\": arnData[i].status == \"PEN\" ? \"Pending\" : \"Completed\",\r\n                  \"profile\": arnData[i].profile,\r\n                  \"rtnPrd\": arnData[i].rtnPrd\r\n                });\r\n              }\r\n            }\r\n            $scope.arnPageData = new NgTableParams(\r\n              {\r\n                count: 5,\r\n              },\r\n              {\r\n                counts: [],\r\n                dataset: $scope.arnValues,\r\n              }\r\n            );\r\n          }\r\n          if (val === 0) {\r\n\r\n            $scope.getFY();\r\n          }\r\n        }\r\n        else {\r\n\r\n          $scope.errormessage = true;\r\n          $scope.errMsg = val === 1 ? $scope.trans.DRC01_ERR3 : $scope.trans.DRC01_ERR5;\r\n          if (val === 0) {\r\n\r\n            $scope.getFY();\r\n          }\r\n        }\r\n      }, function (resp) {\r\n        $().blockPage(false);\r\n\r\n        $scope.myVar = null;\r\n        $scope.hidtab = true;\r\n        $scope.errormessage = true;\r\n        $scope.errMsg = $scope.trans.DRC01B_SYSTEM_ERR_MSG;\r\n      });\r\n    };\r\n\r\n    $scope.inpValidation = function () {\r\n      $scope.refNumEmpty = false;\r\n      $scope.finYrEmpty = false;\r\n      $scope.rtrnPrdEmpty = false;\r\n      $scope.statusEmpty = false;\r\n    };\r\n\r\n    // $scope.drc03ArnValues = [];\r\n    $scope.arnDrc03Empty = false; // If ARNOfDRC03 is empty this should be true\r\n    $scope.arnDrc03Invalid = false; // If ARNOfDRC03 is Invalid this should be true\r\n\r\n    /*Item for Dropdown*/\r\n    $scope.items = [\"Pending\", \"Completed\"];\r\n\r\n    /*Items for Dropdown*/\r\n    $scope.myVar = null;\r\n    $scope.fltrStatus = \"\";\r\n    $scope.resetFlag = function () {\r\n      $scope.validARN = \"\";\r\n      $scope.refNumEmpty = false;\r\n      $scope.finYrEmpty = false;\r\n      $scope.rtrnPrdEmpty = false;\r\n      $scope.statusEmpty = false;\r\n      $scope.hidtab = false;\r\n    };\r\n\r\n    // *************** Navigating To Return Compliance ***************\r\n    $scope.navigateToRtnCmp = function () {\r\n      window.location.href =\r\n        $scope.servers[\"GST_RETURNS_R1_URL\"] + \"/returns/auth/returnComp\";\r\n    };\r\n\r\n    // *************** Function for filtering using RefNo ***************\r\n    $scope.fltrByRefNo = function (refNum) {\r\n      $scope.resetFlag();\r\n      $scope.errormessage = false;\r\n      $scope.hidtab = true;\r\n      var arnTest = new RegExp(/[a-zA-Z0-9]{15}/);\r\n      if (arnTest.test(refNum)) {\r\n        $scope.validARN = \"\";\r\n        $scope.searchParams = { \"gstin\": \"\", \"refNo\": refNum, \"fy\": \"\", \"txPrd\": \"\", \"status\": \"\", \"form_typ\": \"DRC01B\" };\r\n        $scope.arnValuesOnload(1);\r\n\r\n      }\r\n      else {\r\n        $scope.arnValues = [];\r\n        $scope.resetFlag();\r\n        $scope.validARN = $scope.trans.DRC01_ERR2;\r\n\r\n      }\r\n      if (refNum === undefined || refNum === null || refNum === \"\") {\r\n        $scope.refNumEmpty = true;\r\n        $scope.resetFlag();\r\n        $scope.inpValidation();\r\n        $scope.errormessage = true;\r\n        $scope.arnValues = [];\r\n        $scope.validARN = $scope.trans.DRC01_ERR1;\r\n      }\r\n    };\r\n\r\n    // ***************** Function for filtering using Return Period ***************\r\n    $scope.filterByRtrnPrd = function (finYr, retrnPrd) {\r\n      $scope.resetFlag();\r\n      $scope.errormessage = false;\r\n      //$scope.hidtab = true;\r\n      if ((finYr === undefined && retrnPrd === undefined) || (finYr === null && retrnPrd === null) || (finYr === \"\" && retrnPrd === \"\")) {\r\n        $scope.finYrEmpty = true;\r\n        $scope.rtrnPrdEmpty = true;\r\n        //$scope.resetFlag();\r\n      } else if (finYr === undefined || finYr === null || finYr === \"\") {\r\n        $scope.finYrEmpty = true;\r\n        $scope.rtrnPrdEmpty = false;\r\n        //$scope.resetFlag();\r\n      } else if (retrnPrd === undefined || retrnPrd === null || retrnPrd === \"\") {\r\n        $scope.finYrEmpty = false;\r\n        $scope.rtrnPrdEmpty = true;\r\n        //$scope.resetFlag();\r\n      } else {\r\n        $scope.hidtab = true;\r\n        $scope.inpValidation();\r\n        finYr = finYr.replaceAll(/\\s+/g, '');\r\n        finYr = finYr.substring(0, 5) + finYr.substring(0, 2) + finYr.substring(5);\r\n        retrnPrd = retrnPrd.replaceAll(/\\s+/g, '');\r\n\r\n        $scope.searchParams = { \"gstin\": \"\", \"refNo\": \"\", \"fy\": finYr, \"txPrd\": retrnPrd, \"status\": \"\", \"form_typ\": \"DRC01B\" };\r\n        $scope.arnValuesOnload(1);\r\n\r\n      }\r\n    };\r\n\r\n    // ***************** Function for filtering using Status ***************\r\n    $scope.filterByStatus = function (status) {\r\n      $scope.resetFlag();\r\n      $scope.errormessage = false;\r\n      // $scope.hidtab = true;\r\n      if (status === undefined || status === null || status === \"\") {\r\n        $scope.statusEmpty = true;\r\n        // $scope.resetFlag();\r\n      } else if (status !== undefined || status !== null || status !== \"\") {\r\n        // HardCoded Values\r\n        $scope.hidtab = true;\r\n        if (status === \"Completed\" || \"Pending\") {\r\n          if (status === \"Completed\") {\r\n            $scope.inpValidation();\r\n            $scope.searchParams = { \"gstin\": \"\", \"refNo\": \"\", \"fy\": \"\", \"txPrd\": \"\", \"status\": \"CMPLT\", \"form_typ\": \"DRC01B\" };\r\n            $scope.arnValuesOnload(1);\r\n          } else if (status === \"Pending\") {\r\n            $scope.inpValidation();\r\n            $scope.searchParams = { \"gstin\": \"\", \"refNo\": \"\", \"fy\": \"\", \"txPrd\": \"\", \"status\": \"PEN\", \"form_typ\": \"DRC01B\" };\r\n            $scope.arnValuesOnload(1);\r\n          }\r\n        } else {\r\n          $scope.inpValidation();\r\n          $scope.errormessage = true;\r\n          $scope.errMsg = $scope.trans.DRC01_ERR3;\r\n        }\r\n        // HardCoded Values\r\n      }\r\n    };\r\n\r\n    $scope.clickArn = function (detail) {\r\n      var monthQtr = [\"\", \"Jan\", \"Jan-Feb\", \"Jan-Mar\", \"Apr\", \"Apr-May\", \"Apr-Jun\", \"Jul\", \"Jul-Aug\", \"Jul-Sep\", \"Oct\", \"Oct-Nov\", \"Oct-Dec\"];\r\n      var month = [\"\", \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\r\n      if (angular.isDefined(shareData.enableChkBox) && (!shareData.enableChkBox)) {\r\n        $scope.verification = true;\r\n        $scope.enableChkBox = false;\r\n        $scope.disableFile = false;\r\n        $scope.disableSave = true;\r\n        $scope.saveSuccess = false;\r\n        $scope.dateSign = shareData.dateSign;\r\n        $scope.places = shareData.places;\r\n        $scope.panNames = shareData.panNames;\r\n        $scope.panName = shareData.dscAuth.name;\r\n        $scope.designation = shareData.dscAuth.dg;\r\n      }\r\n      else {\r\n      $scope.disableSave = false;\r\n      }\r\n      $scope.arnDrcErr = \"\";\r\n      $scope.arnDrcVal = {val : \"\"};\r\n      shareData.dataDetail = detail;\r\n      $scope.fy = detail.FinancialYear;\r\n      $scope.status = detail.Status;\r\n      $scope.arn = detail.refId;\r\n      $scope.profile = detail.profile;\r\n      $scope.currentPrd = detail.rtnPrd;\r\n      if (shareData.finalFlag || $scope.status === \"Completed\") {\r\n        $scope.finalFlag = shareData.finalFlag = true;\r\n      }\r\n      else {\r\n        $scope.finalFlag = false;\r\n      }\r\n      var url = $scope.servers[\"GST_RETURNS_R1_URL\"] + \"/spikeweb/auth/web/getRCSummary\";\r\n      var params = { \"refNo\": $scope.arn };\r\n      $().blockPage(true);\r\n      ajax.get(url, params).then(function (response) {\r\n        $().blockPage(false);\r\n        if (response.status === 1) {\r\n          if (response.data) {\r\n            $scope.liabilityPaidData = response.data;\r\n            $scope.drc01bData = $scope.liabilityPaidData.getRCSummary;\r\n            $scope.gstin = response.data.referenceNumber;\r\n            $scope.bn = response.data.Tradename;\r\n            $scope.ln = response.data.Legalname;\r\n            $scope.drc03ArnValues = [];\r\n            $scope.name = $scope.liabilityPaidData.name ? $scope.liabilityPaidData.name : \"\";\r\n            $scope.dg = $scope.liabilityPaidData.dg ? $scope.liabilityPaidData.dg : \"\";\r\n            $scope.filingDate = $scope.liabilityPaidData.filingDate ? $scope.liabilityPaidData.filingDate : \"\";\r\n            $scope.dcLen = 0;\r\n            if ($scope.liabilityPaidData.Profile === 'Q') {\r\n              var sampleObj1 = {}, sampleObj2 = {}\r\n              if (parseInt($scope.currentPrd.substring(0, 2)) % 3 === 0) {\r\n                sampleObj1 = {\r\n                  rtnPrd: padding(parseInt($scope.currentPrd.substring(0, 2)) - 2) + $scope.drc01bData[0].rtnPrd.substring(2),\r\n                  returnType: \"IFF\"\r\n                };\r\n                sampleObj2 = {\r\n                  rtnPrd: padding(parseInt($scope.currentPrd.substring(0, 2)) - 1) + $scope.drc01bData[0].rtnPrd.substring(2),\r\n                  returnType: \"IFF\"\r\n                };\r\n              }\r\n              else if (parseInt($scope.currentPrd.substring(0, 2)) % 3 === 2) {\r\n                sampleObj2 = {\r\n                  rtnPrd: padding(parseInt($scope.currentPrd.substring(0, 2)) - 1) + $scope.drc01bData[0].rtnPrd.substring(2),\r\n                  returnType: \"IFF\"\r\n                };\r\n              }\r\n              if ($scope.drc01bData.length < 5 && parseInt($scope.currentPrd.substring(0, 2)) % 3 === 0) {\r\n                if ($scope.drc01bData.length == 3) {\r\n                  $scope.drc01bData.unshift(sampleObj1, sampleObj2);\r\n                }\r\n                else {\r\n                  if (parseInt($scope.drc01bData[0].rtnPrd.substring(0, 2)) % 3 == 1) {\r\n                    var m2 = $scope.drc01bData.splice(0, 1);\r\n                    $scope.drc01bData.unshift(m2[0], sampleObj2);\r\n                  }\r\n                  else {\r\n                    $scope.drc01bData.unshift(sampleObj1);\r\n                  }\r\n                }\r\n              }\r\n              else if ($scope.drc01bData.length < 4 && parseInt($scope.currentPrd.substring(0, 2)) % 3 === 2) {\r\n                if ($scope.drc01bData.length == 3) {\r\n                  $scope.drc01bData.unshift(sampleObj2);\r\n                }\r\n              }\r\n              for (var i = 0; i < $scope.drc01bData.length - 1; i++) {\r\n                if ($scope.drc01bData[i].rtnPrd) {\r\n                  $scope.drc01bData[i].retPrd = month[parseInt($scope.drc01bData[i].rtnPrd.substring(0, 2))] + \" - \" + $scope.drc01bData[i].rtnPrd.substring(2);\r\n                }\r\n                else {\r\n                  $scope.drc01bData[i].retPrd = month[parseInt($scope.currentPrd.substring(0, 2))] + \" - \" + $scope.currentPrd.substring(2);\r\n                }\r\n              }\r\n              $scope.drc01bData[$scope.drc01bData.length - 1].retPrd = \"\";\r\n            }\r\n            $scope.amount = $filter('INR')(parseFloat($scope.drc01bData[$scope.drc01bData.length - 1].total).toFixed(2));\r\n            if ($scope.liabilityPaidData.Reasons) {\r\n              $scope.reason = {\r\n                field1: $scope.liabilityPaidData.Reasons[2]...[truncated at 15000 chars]"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 77235

t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\telse\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\tdt = goliveDt;\r\n\t\t\t\t\t\t\t\tisdue = true;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tif(isdue)\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\tshareData.duedt = $scope.dueDt = moment(\"31/12/2018\",'DD/MM/YYYY').format('DD/MM/YYYY');\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t}\t\r\n\t\t\t\t\t\t\telse\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\tshareData.duedt = $scope.dueDt = dt.add(3, 'M').format('DD/MM/YYYY');\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t// RQM - 17332 -If the due date is between 20th March 2020 to 30th August 2020 \r\n\t\t\t\t\t\t\t//then setting the due date as 31st August 2020 due to covid-19 pandemic \r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t//var stDt = \"19/03/2020\";\r\n\t\t\t\t\t\t\t//var edDt = \"30/06/2020\";\r\n\t\t\t\t\t\t\tvar dateFormatting = \"DD/MM/YYYY\";\r\n\t\t\t\t\t\t\t//if((moment($scope.dueDt,dateFormatting).isAfter(moment(stDt,dateFormatting))) && \r\n\t\t\t\t\t\t\t//\t\t(moment($scope.dueDt,dateFormatting).isBefore(moment(edDt,dateFormatting))))\r\n\t\t\t\t\t\t\tif((moment($scope.dueDt,dateFormatting).isAfter(moment(shareData.gstr10_startDt,dateFormatting))) && \r\n\t\t\t\t\t\t\t\t(moment($scope.dueDt,dateFormatting).isBefore(moment(shareData.gstr10_endDt,dateFormatting))))\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t//shareData.duedt = $scope.dueDt = moment(\"30/06/2020\",'DD/MM/YYYY').format('DD/MM/YYYY');\r\n\t\t\t\t\t\t\t    shareData.duedt = $scope.dueDt = moment(shareData.gstr10_dueDt,'DD/MM/YYYY').format('DD/MM/YYYY');\t\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tlocalStorage.setItem('rtn_prd',shareData.rtn_prd);\r\n\t\t\t\t\t\t\t$scope.formDetails();\t\r\n\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\t$scope.fileStatusExpiry = false;\r\n\t\t\t\t\t\t\t\t\tshareData.rtn_prd = shareData.gstr10_fp = calDt.format('MMYYYY')\r\n\t\t\t\t\t\t\tvar dt;\r\n\t\t\t\t\t\t\tvar isdue = false;\r\n\t\t\t\t\t\t\tif(calDt > odrDt && calDt > goliveDt)\r\n\t\t\t\t\t\t\t\tdt = cal
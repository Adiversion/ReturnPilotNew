            "text": "myApp.controller(\"gstr10ctrl\", gstr10ctrl);\r\nmyApp.controller('gstr10ptferrorctrl', gstr10ptferrorctrl);\r\n\r\ngstr10ctrl.$inject = ['$scope', '$location', '$rootScope', 'shareData', '$window', 'ajax', '$route', 'NgTableParams', 'utilFunctions', '$compile', 'validations', '$timeout', 'FormSubmitter', '$filter'];\r\ngstr10ptferrorctrl.$inject = ['$scope', '$location', '$rootScope', 'shareData', 'ajax', '$route', 'NgTableParams', 'utilFunctions', '$compile', 'cache', '$timeout'];\r\n\r\nfunction gstr10ctrl($scope, $location, $rootScope, shareData, $window, ajax, $route, NgTableParams, utilFunctions, $compile, validations, $timeout, FormSubmitter, $filter) {\r\n\tif ($().getConstant(\"rtn_prd\")) {\r\n\t\tlocalStorage.setItem('rtn_prd', $().getConstant(\"rtn_prd\"));\r\n\t}\r\n\tif ($().getConstant(\"bck_flag\")) {\r\n\t\tlocalStorage.setItem('BCK_FLAG', $().getConstant(\"bck_flag\"));\r\n\t}\r\n\tif ($().getConstant(\"formname\")) {\r\n\t\tlocalStorage.setItem('formname', $().getConstant(\"formname\"));\r\n\t}\r\n\t\r\n\t$scope.udatasp = 'C';\r\n\t$scope.fileStatus = false;\r\n\t//separating cr 16773b and 18012\r\n//     $scope.getCancellationStatus = function(){\r\n//         $rootScope.$on(\"udatasp\", function (evt, data) {\r\n//         console.log(\"Sucess\",data)\r\n//         $scope.udatasp = data.udatasp.appStatus;\r\n//         if($scope.udatasp == 'C'){\r\n//             $scope.gstr10tile();\r\n//         }\r\n// \t});\r\n// }\r\n\r\n\t$scope.fail_msg = false;\r\n\t//shareData.success_msg = false;\r\n\r\n\t$scope.success_msg = shareData.success_msg;\r\n\t$scope.igst_disable_flag = false;\r\n\t$scope.cgst_disable_flag = false;\r\n\t$scope.sgst_disable_flag = false;\r\n\r\n\t$scope.expanded = false;\r\n\t$scope.expanded1 = false;\r\n\t$scope.fexpand = function () {\r\n\t\t$scope.expanded = !$scope.expanded;\r\n\t}\r\n\t$scope.fexpandAddr = function () {\r\n\t\t$scope.expanded1 = !$scope.expanded1;\r\n\t}\r\n\r\n\t$scope.page_rtp = function(path, due, stat){\r\n\t\tif(path =='GSTR10'){\r\n\t\t\twindow.location.href ='/returns2/auth/gstr10';\r\n\t\t\twindow.localStorage.removeItem(\"BCK_FLAG\");\r\n\t\t}\r\n\t}\r\n\r\n\t$scope.page = function (path) {\r\n\t\t$scope.success_msg = shareData.success_msg = false;\r\n\t\t$location.path(path);\r\n\t};\r\n\r\n\t$scope.back = function () {\r\n\t\twindow.location.href = '/returns/auth/finalreturn';\r\n\t}\r\n\r\n\t$scope.atab = false;\r\n\t$scope.pageRedirect = function () {\r\n\t\t$scope.success_msg = shareData.success_msg = false;\r\n\t\t$scope.atab = true;\r\n\t\t$location.path('/auth/gstr10/itemsummary');\r\n\t}\r\n\t$scope.pageRedirectUp = function () {\r\n\t\t$scope.success_msg = shareData.success_msg = false;\r\n\t\t$scope.atab = false;\r\n\t\t$location.path('/auth/gstr10/documentsummary');\r\n\t}\r\n\r\n\tif ($location.path() == '/auth/gstr10/withinvoicesummary') {\r\n\t\t$scope.invoiceDet = true;\r\n\t\tshareData.docDet = $scope.docDet = false;\r\n\t\tshareData.itemDet = $scope.itemDet = false;\r\n\t} else if ($location.path() == '/auth/gstr10/documentsummary') {\r\n\t\t$scope.invoiceDet = false;\r\n\t\tshareData.docDet = $scope.docDet = true;\r\n\t\tshareData.itemDet = $scope.itemDet = false;\r\n\t} else if ($location.path() == '/auth/gstr10/itemsummary') {\r\n\t\tshareData.docDet = $scope.docDet = false;\r\n\t\tshareData.itemDet = $scope.itemDet = true;\r\n\t}\r\n\r\n\t$scope.getDetails = function(){\r\n\t\t$('[name=staus_msg]').empty();\r\n\t\t$('[name=staus_msg1]').empty();\r\n\t\tajax.get(\"/returns2/auth/api/gstr10/userdtls\" ,{},{},\r\n\t\t\t\tfunction(){\r\n\t\t\t\t$().blockPage(true);\r\n\t\t\t\t},function(){\r\n\t\t\t\t$().blockPage(false);\r\n\t\t\t} ).then(function (response, status, header) {\r\n\t\t\t\t\tif (response.status == 1) {\r\n\t\t\t\t\tshareData.gstr10_gstin=response.data.gstin;\r\n\t\t\t\t\t//shareData.apprvDate=response.data.aprvDt;\r\n\t\t\t\t\t$scope.formGstin= shareData.gstr10_gstin;\r\n\t\t\t\t\tshareData.gstr10_userTyp = response.data.userType;\r\n\t\t\t\t    if(shareData.gstr10_userTyp == \"CA\"){\r\n\t\t\t\t\t\t$scope.fileStatus = true\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\t$scope.fileStatus = false;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tshareData.gstr10_goliveDt = response.data.ret_live_dt;\r\n\t\t\t\t\tshareData.gstr10_startDt = response.data.ret_st_dt;\r\n\t\t\t\t\tshareData.gstr10_endDt = response.data.ret_end_dt;\r\n\t\t\t\t\tshareData.gstr10_dueDt = response.data.ret_due_dt;\r\n\t\t\t\t\t$scope.gstr10Data();\r\n\t\t\t\t\t} else if (response.status == 0){\r\n\t\t\t\t\t\t$().blockPage(false);\r\n\t\t\t\t\t\t$scope.summaryFlag = false;\r\n\t\t\t\t\t\tshareData.summaryFlag = $scope.summaryFlag;\r\n\t\t\t\t\t\t$scope.fail_msg= true;\r\n\t\t\t\t\t\t$scope.summaryMsg = response.error.message;\r\n\t\t\t\t\t}\r\n\t\t\t\t}, function(err) {\r\n\t\t\t\t\tvar url = $().getServers().GST_SERVICES_R1_URL + \"/services/error/system\";\r\n\t\t\t\t\t$window.location.href = url;\r\n\t\t\t\t});\r\n\t\t}\r\n\r\n\t//CA certificate\r\n\r\n\t$scope.emptyobj = function () {\r\n\t\tvar conf = utilFunctions.createDialogue({\r\n\t\t\t\"title\": \"\",\r\n\t\t\t\"type\": \"Warning\",\r\n\t\t\t\"message\": \"On uploading new file existing saved file will get deleted. Do you want to Continue?\",\r\n\t\t\t\"callback\": \"deleteFile\",\r\n\t\t\t\"ok_btn_title\": \"Proceed\",\r\n\t\t\t\"cancel_btn_title\": \"Cancel\"\r\n\t\t});\r\n\t\t$('body').append($compile(conf)($scope));\r\n\t\t$(\"#confirmDlg\").modal('show');\r\n\t}\r\n\t$scope.deleteFile = function () {\r\n\t\tdelete $scope.FileObj;\r\n\t\t$('#confirmDlg').modal('hide');\r\n\t\tdelete $scope.gstr10CaData.docid;\r\n\t}\r\n\t$scope.destroyModal = function () {\r\n\t\tutilFunctions._destroyDialogue();\r\n\t\t$('body').css('padding-right', 0);\r\n\t};\r\n\r\n\t$scope.caDetails = {};\r\n\r\n\tvar dateFormat = $().getConstant('DATE_FORMAT') || 'DD/MM/YYYY';\r\n\t$scope.maxmDate2 = moment().format(\"DD/MM/YYYY\");\r\n\r\n\t$scope.isValidDate = function (date) {\r\n\t\tvar dateFormat = \"DD/MM/YYYY\";\r\n\t\treturn moment(date, dateFormat, true).isValid();\r\n\t};\r\n\t$scope.checkdt = function () {\r\n\t\tif (!$scope.isValidDate($scope.caDetails.cadt)) {\r\n\t\t\t$scope.filing.cadt.$setValidity(\"dflag\", false);\r\n\t\t\t$scope.camsg1 = \"Check if you have entered correct date and format(dd/mm/yyyy).\";\r\n\t\t} else {\r\n\t\t\t$scope.filing.cadt.$setValidity(\"dflag\", true);\r\n\t\t\tdelete $scope.camsg1;\r\n\t\t}\r\n\t\tif (moment($scope.caDetails.cadt, dateFormat).isAfter(moment($scope.maxmDate2, dateFormat))) {\r\n\t\t\t$scope.filing.cadt.$setValidity(\"dtflag\", false);\r\n\t\t\t$scope.camsg = \"Date cannot be a future date.\";\r\n\t\t} else {\r\n\t\t\t$scope.filing.cadt.$setValidity(\"dtflag\", true);\r\n\t\t\tdelete $scope.camsg;\r\n\t\t}\r\n\t}\r\n\r\n\t//attachment check\r\n\t$scope.attached = false;\r\n\t$scope.uploadAttach = function (val) {\r\n\t\tif (!val) {\r\n\t\t\t$scope.suc_msg = false;\r\n\t\t\t$scope.sub = true;\r\n\t\t\tshareData.attached = false;\r\n\t\t\t$scope.caerr = \"Please select file to upload\";\r\n\t\t\treturn false;\r\n\t\t} else {\r\n\t\t\t$scope.caerr = \"\";\r\n\t\t\t$scope.sub = false;\r\n\t\t}\r\n\t\tif ($scope.caDetails) {\r\n\t\t\tif ($scope.filing && $scope.filing.$valid) {  /* && $scope.address.$valid */\r\n\t\t\t\tif (val) {\r\n\t\t\t\t\t$scope.sub = false;\r\n\t\t\t\t\t$scope.docid = val ? val[0].id : undefined;\r\n\t\t\t\t\t$scope.hashid = val ? val[0].hash : undefined;\r\n\t\t\t\t\t$scope.ty = val ? val[0].ty : undefined;\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$scope.docid = shareData.pdfData.docid;\r\n\t\t\t\t\t$scope.hashid = shareData.pdfData.hashid;\r\n\t\t\t\t\t$scope.ty = shareData.pdfData.ty;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tvar attachment = [];\r\n\t\t\t\tvar object1 = {\r\n\t\t\t\t\tdocid: $scope.docid,\r\n\t\t\t\t\tcaDetails: $scope.caDetails,\r\n\t\t\t\t\thash: $scope.hashid,\r\n\t\t\t\t\tty: $scope.ty\r\n\t\t\t\t}\r\n\t\t\t\tattachment.push(object1);\r\n\t\t\t\tvar attach = {\r\n\t
          "content": {
            "size": 72408,
            "mimeType": "text/html",
            "text": "<style>\r\n    .offline_btn {\r\n        padding-left: 15px;\r\n        padding-right: 15px;\r\n    }\r\n    \r\n    .mark {\r\n        color: #14385D;\r\n    }\r\n    .khakhi{\r\n        color: khaki;\r\n    }\r\n    \r\n    .content-pane-returns {\r\n        background-color: white;\r\n        padding: 0px 15px 30px 15px;\r\n    }\r\n    .infoalign{\r\n        \r\n        margin-left: 1.2%;\r\n        margin-right: 1%;\r\n        }\r\n    .retpad {\r\n        padding-bottom: 195px;\r\n    }\r\n    \r\n    .srchbtn {\r\n        margin-top: 25px;\r\n    }\r\n    \r\n    .srchbtn1 {\r\n        margin-top: 65px;\r\n    }\r\n    \r\n    .gtsave {\r\n        width: 20%;\r\n    }\r\n    \r\n    .disableTile {\r\n        position: absolute;\r\n        background: #eee;\r\n        top: 0;\r\n        bottom: 0;\r\n        left: 0;\r\n        right: 0;\r\n        opacity: 0.5;\r\n        z-index: 100;\r\n        margin: 0 15px;\r\n        cursor: pointer;\r\n    }\r\n    .disableTile1A {\r\n        background: #eee;        \r\n        z-index: 100;\r\n        margin: 0 15px;\r\n\t\tcursor : not-allowed!important;\r\n\t\topacity: 0.3!important;\r\n\t\ttext-decoration: none!important;\r\n    }\r\n    .disableClick {\r\n\t\tcursor : not-allowed!important;\r\n    }\r\n\r\n    .whiteside {\r\n        background-color: #FFFAF0;\r\n        padding: 10px;\r\n        color: black;\r\n    }\r\n    .card .hd {\r\n        height:113px;\r\n    }\r\n    .smallbutton {\r\n        padding: 5px 10px;\r\n        font-size: 14px;\r\n        line-height: 1.5;\r\n        border-radius: 0px;\r\n    }\r\n    .mar60{\r\n        margin-left: 60% !important;\r\n    }\r\n    .disableTable {\r\n        pointer-events: none;\r\n        background: #eee;\r\n        top: 0;\r\n        bottom: 0;\r\n        left: 0;\r\n        right: 0;\r\n        opacity: 0.5;\r\n        cursor: not-allowed;\r\n    }\r\n</style>\r\n<alert-message ng-show=\"showMsg\" title=\"\" type=\"msg alert-{{mType}}\" message=\"{{message}}\"></alert-message>\r\n<!-- //CR17074 changes -->\r\n <div class=\"alert alert-msg alert-danger alert-dismissible \" data-ng-if=\"gstr3berrmsg || gstr3berrmsg2\">\r\n    <strong data-ng-bind=\"gstr3berrmsg || gstr3berrmsg2\"></strong>\r\n    <button type=\"button\" class=\"close\" data-dismiss=\"alert\" aria-hidden=\"true\" data-ng-click=\"closeMsg();closeOffMsg()\">\r\n                        <i class=\"fa fa-times\"></i>\r\n                    </button>\r\n</div>\r\n\r\n<!-- //CR17074 changes -->\r\n<div class=\"alert alert-msg alert-success alert-dismissible \" data-ng-show=\"qrtSuccessFlag\">\r\n    <strong data-ng-bind=\"qrtSuccessMsg\"></strong>\r\n    <button type=\"button\" class=\"close\" data-dismiss=\"alert\" aria-hidden=\"true\">\r\n        <i class=\"fa fa-times\"></i>\r\n    </button>\r\n</div>\r\n<div class=\"content-pane-returns\">\r\n    <div class=\"row\">\r\n        <div class=\"col-sm-12\">\r\n            <h4>File Returns</h4>\r\n            <hr>\r\n        </div>\r\n    </div>\r\n    <!-- <marquee class=\"mark\" data-ng-if=\"ret_prd_flag && quarterEditFlag\">\r\n        Edit Option for change in return frequency for normal taxpayers who has selected quarterly return filing and has not filed GSTR-1 quarterly has been enabled.\r\n    </marquee>\r\n\t<marquee class=\"mark\" data-ng-show=\"gstr2aFlag =='GSTR2A'\">\r\n        GSTR-2A can now be downloaded in excel/CSV format for your reference and further use\r\n    </marquee>\r\n    <marquee class=\"mark\">\r\n        Nil return for GSTR-3B & GSTR-1 can now be filed through SMS.\r\n    </marquee> -->\r\n    <marquee class=\"mark\" data-ng-if=\"(ret_prd_flag && quarterEditFlag) || gstr2aFlag =='GSTR2A'\">\r\n        <span data-ng-if=\"ret_prd_flag && quarterEditFlag\"> Edit Option for change in return frequency for normal taxpayers who has selected quarterly return filing and has not filed GSTR-1 quarterly has been enabled. </span>\r\n        <span data-ng-show=\"gstr2aFlag =='GSTR2A'\"> GSTR-2A can now be downloaded in excel/CSV format for your reference and further use. </span>\r\n        <span data-ng-if=\"servers.GST_RETURNS_R1_URL.substr(2,4) != 'trng'\"> Nil return for GSTR-1, GSTR-3B and CMP-08 can now be filed through SMS.</span>\r\n    </marquee>\r\n    <marquee class=\"mark\" data-ng-if=\"(!((ret_prd_flag && quarterEditFlag) || gstr2aFlag =='GSTR2A') && (udata.utype =='TP' || udata.utype =='NT')) && servers.GST_RETURNS_R1_URL.substr(2,4) != 'trng'\">\r\n        <span> Nil return for GSTR-1, GSTR-3B and CMP-08 can now be filed through SMS.</span>\r\n    </marquee>\r\n    <p class=\"mand-text\" data-ng-bind=\"trans.HLP_MAND_FIELD\"></p>\r\n    <form name=\"dashboard\" novalidate=\"\" data-ng-init=\"finprd()\" data-ng-submit=\"returnPrd(dropdownValues.finyr,dropdownValues.reqmonth);closeOffMsg()\">\r\n        <div class=\"row\">\r\n            <div class=\"col-sm-3 col-xs-12\">\r\n                <label for=\"fin\" class=\"reg m-cir\" data-ng-bind=\"trans.LBL_FIN_YR\"></label>\r\n                <select name=\"fin\" class=\"form-control\" data-ng-model=\"dropdownValues.finyr\" data-ng-options=\"item.year for item in years\" value=\"item.year\" data-ng-change=\"hidedata()\" required>\r\n                </select>\r\n                <span class=\"err\" data-ng-show=\"dashboard.$submitted && dashboard.fin.$error.required\" data-ng-bind=\"trans.ERR_MANDATORY\"></span>\r\n\r\n            </div>\r\n            <div class=\"col-sm-3 col-xs-12\"\r\n                data-ng-if=\"currentyear && showQuarterdropDown && udata.regType != 'CA' && udata.regType != 'ID' && (udata.utype=='CO' || udata.utype=='TP' || udata.utype=='NT')\">\r\n                <label for=\"quarter\" class=\"reg m-cir\" data-ng-bind=\"trans.LBL_QTR\"></label>\r\n                <select name=\"quarter\" class=\"form-control\" ng-model=\"dropdownValues.quart\"\r\n                    data-ng-options=\"item.name for item in quarters\" value=\"item.name\" ng-change=\"qtrfunc(quart)\"\r\n                    required>\r\n                </select>\r\n                <span class=\"err\" data-ng-show=\"dashboard.$submitted && dashboard.qtr.$error.required\"\r\n                    data-ng-bind=\"trans.ERR_MANDATORY\"></span>\r\n            </div>  \r\n            <div class=\"col-sm-3 col-xs-12\">\r\n                <label for=\"mon\" class=\"reg m-cir\" data-ng-bind=\"trans.LBL_PRD\"></label>\r\n                <select name=\"mon\" class=\"form-control\" data-ng-model=\"dropdownValues.reqmonth\"\r\n                    data-ng-options=\"item.month for item in reqmonths\" value=\"item.value\" required>\r\n                </select>\r\n                <span class=\"err\" data-ng-show=\"dashboard.$submitted && dashboard.mon.$error.required\"\r\n                    data-ng-bind=\"trans.ERR_MANDATORY\"></span>\r\n\r\n            </div>\r\n            <div class=\"col-sm-3 col-xs-12\">\r\n\r\n                <button class=\"btn btn-primary srchbtn\" type=\"submit\">Search</button>\r\n            </div>\r\n\r\n        </div>\r\n        <div ng-repeat=\"div in warningcontent track by $index\">\r\n            <div data-ng-if=\"showMessage\" class=\"alert alert-msg alert-danger alert-dismissible\">{{div.content}}<button type=\"button\" class=\"close\" data-dismiss=\"alert\" aria-hidden=\"true\" data-ng-click=\"closeWarningMsg()\">\r\n                            <i class=\"fa fa-times\"></i>\r\n                        </button>\r\n            </div>\r\n        </div>\r\n        <!-- Reverting CR21918- MSME static message starts here-->\r\n        <!-- <div class =\"row\">\r\n            <div class=\"col-sm-12 col-xs-12\">\r\n                <p style=\"background-color:beige\">If you are Micro, Small or Medium Enterprise (MSME) <a data-ng-click=\"openmsme()\">Click here</a> to submit your interest for availing Mudra Loan upto 10 Lacs or MSME Loan upto 5 Cr. under respective loan schemes.</p>\r\n            </div>\r\n        </div> -->\r\n        <!--CR21918- MSME static message ends here-->\r\n    </form>\r\n    <!-- code for preference -->\r\n    <hr>\r\n    <div class=\"rettbl-format\">\r\n        <div class=\"row\">\r\n            <div class=\"col-sm-12\">\r\n                <br>\r\n                <ol>\r\n                    <li data-ng-show=\"obPage && (udata.regType != 'TD' && udata.regType != 'TC' && udata.regType != 'ID')\">\r\n                        <a class=\"inverseLink\" target=\"_self\" href=\"{{servers.GST_RETURNS_R1_URL}}/returns/auth/obdeclaration\"><span>{{trans.LBL_OB}}</span></a>\r\n                    </li>\r\n                    <li data-ng-show=\"rcmobPage && (udata.regType != 'TD' && udata.regType != 'TC' && udata.regType != 'ID')\">\r\n                        <a class=\"inverseLink\" target=\"_self\" href=\"{{servers.GST_RETURNS_R1_URL}}/returns/auth/rcmobdeclaration\"><span>{{trans.ITC_REV_OPN_BAL}}</span></a>\r\n                    </li>\r\n                </ol>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <!--CR21918- MSME pop up starts here-->\r\n    <!-- <div id=\"msmeModal\" class=\"modal fade\" role=\"dialog\">\r\n        <div class=\"modal-dialog sweet\" style=\"width :850px\">\r\n            <div class=\"modal-content\"> \r\n                <div class=\"modal-header\">\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\">\r\n                    <span aria-hidden=\"true\">×</span></button>\r\n                    <h4 data-ng-bind=\"trans.LBL_DASH_HEAD_MSME\"></h4>\r\n                </div>\r\n  \r\n                <div class=\"modal-body\" data-ng-if=\"msmeFlag == 'NA' \">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-sm-12 xs-12\">\r\n                        <p data-bind-unsafe-html=\"trans.LBL_MSME_QUEST_1\"></p>\r\n\t\t\t\t\t    </div>\r\n                    </div>\r\n                    <div class=\"row\">\r\n                        <div class=\"col-sm-12 col-xs-12\">\r\n                        <ol type=\"1\">\r\n                            <li>{{trans.LBL_MSME_DTL_3}}</li>\r\n                            <li>{{trans.LBL_MSME_DTL_2}}</li>\r\n                            <li>{{trans.LBL_MSME_DTL_4}}</li>\r\n                            <li>{{trans.LBL_MSME_DTL_5}}</li>\r\n                            <ol type=\"a\">\r\n                                <li>{{trans.LBL_MSME_DTL_7}}</li>\r\n                                <li>{{trans.LBL_MSME_DTL_8}}</li>\r\n                                <li>{{trans.LBL_MSME_DTL_9}}</li>\r\n                            </ol>\r\n                            <li>{{trans.LBL_MSME_DTL_6}}</li>\r\n                        </ol>\r\n                        <p>{{trans.LBL_MSME_QUEST}}</p>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"row\">\r\n                        <div class=\"col-sm-12 col-xs-12\">\r\n                            <fieldset>\r\n                                <input type=\"radio\" name=\"msme\" id=\"radioyes\" data-ng-model=\"msmeval\" value=\"Y\" data-ng-checked=\"msmeval=='Y'\">\r\n                                <label for=\"radioyes\" data-ng-bind=\"trans.MSME_YES\">YES</label>\r\n                                    &nbsp; &nbsp;\r\n                                <input type=\"radio\" name=\"msme\" id=\"radiono\" data-ng-model=\"msmeval\" value=\"N\" data-ng-checked=\"msmeval=='N'\">\r\n                                <label for=\"radiono\" data-ng-bind=\"trans.MSME_NO\">NO</label>\r\n                            </fieldset>\r\n                        </div>\r\n                    </div>\r\n\t\t\t        <div class=\"row\" data-ng-if=\"msmeval == 'Y' \" >\r\n                        <div class=\"col-sm-12 col-xs-12\">\r\n\t\t\t\t        <p> Do you  want? </p>\r\n\t\t\t\t        </div>\r\n\t\t\t         </div>\r\n\t\t\t         <div class=\"row\" data-ng-if=\"msmeval == 'Y' \">\r\n                        <div class=\"col-sm-12 col-xs-12\">\r\n                            <fieldset>\r\n                                    <input type=\"radio\" name=\"loantype\" id=\"radioMudra\" data-ng-model=\"loanval\" value=\"MUDRA\" data-ng-checked=\"loanval=='MUDRA'\">\r\n                                    <label for=\"radiomudra\" >Mudra Loan (Upto Rs. 10 Lacs)</label>\r\n                                    &nbsp; &nbsp;\r\n                                    <input type=\"radio\" name=\"loantype\" id=\"radioMSME\" data-ng-model=\"loanval\" value=\"MSME\" data-ng-checked=\"loanval=='MSME'\">\r\n                                    <label for=\"radiomsme\" >MSME Loan (More than Rs. 10 Lacs upto Rs. 5 Cr.)</label>\r\n                            </fieldset>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\" data-ng-if=\"msmeFlag == 'NA' \">\r\n                    <div class=\"row\" data-ng-if=\"isGstp == 'N' \">\r\n                        <div class=\"col-sm-4 col-xs-12 pull-right\">\r\n                            <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Close</button>\r\n                            <button class=\"btn btn-primary\" data-ng-click=\"msmesubmit(msmeval, loanval)\" data-ng-bind=\"trans.BTN_SUBMIT\">Submit</button>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"row\" data-ng-if=\"isGstp == 'Y' \">\r\n                        <div class=\"col-sm-4 col-xs-12 pull-right\">\r\n                            <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Close</button>\r\n                            <button class=\"btn btn-primary\" title=\"You are not eligible to submit the consent form.\" data-toggle=\"tooltip\"  data-ng-click=\"msmesubmit(msmeval, loanval)\" data-ng-bind=\"trans.BTN_SUBMIT\" data-ng-disabled=\"true\" disabled=\"disabled\">Submit</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                \r\n                <div class=\"modal-body\" data-ng-if=\"msmeFlag == 'Y' \">\r\n                    <p>Thank you very much for giving your consent for sending your details to the Department of Financial Services. The concerned Public Sector Bank will soon contact you for your credit requirement.</p>\r\n                    <div class=\"row\">\r\n                        <div class=\"col-sm-2 col-xs-12 pull-right\">\r\n                            <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Close</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                \r\n                <div class=\"modal-body\" data-ng-if=\"msmeFlag == 'N' \">\r\n                    <p>Response has been provided.</p>\r\n                    <div class=\"row\">\r\n                        <div class=\"col-sm-2 col-xs-12 pull-right\">\r\n                            <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Close</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div data-ng-if=\"errflagmsme\">\r\n                    <p style=\"color:red\">Error in saving, please try after some time.</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div> -->\r\n    <!--CR21918- MSME pop up ends here-->\r\n    <div class=\"alert alert-msg alert-info alert-dismissible \" data-ng-show=\"quarterInfoFlag && (!manageProfileFlag)\"\r\n        data-ng-bind=\"quarterInfoMsg\">\r\n        <button type=\"button\" class=\"close\" data-dismiss=\"alert\" aria-hidden=\"true\">\r\n            <i class=\"fa fa-times\"></i>\r\n        </button>\r\n    </div>\r\n    <!--CR6908:Added a new Edit Button for Edit facility of quarterly to monthly return filing-->\r\n    <div class=\"row\" data-ng-if=\"ret_prd_flag && quarterEditFlag  && (!manageProfileFlag)\">\r\n        <div class=\"col-sm-12 col-xs-12 text-left\">\r\n            <div class=\"col-sm-1 col-xs-1\">\r\n                <button ...[truncated at 15000 chars]"

            "mimeType": "text/html",
            "text": "<style>\r\n    .trn {\r\n        margin-left: -15.90em !important;\r\n    }\r\n\r\n    .nav_home {\r\n        width: 115px;\r\n        text-align: center;\r\n    }\r\n\r\n    .beta_menu {\r\n        margin: 0px 0em 0 -54em;\r\n    }\r\n\r\n    @media screen and (min-width: 760px) {\r\n\r\n        ul.isubmenu.oth.us.es {\r\n            width: 100%;\r\n            margin-left: 0em !important;\r\n        }\r\n    }\r\n\r\n    @media screen and (min-width: 320px) and (max-width: 1200px) {\r\n        .nav_home {\r\n            width: 100%;\r\n            text-align: left;\r\n        }\r\n    }\r\n\r\n    .menuList .disabled:active {\r\n        pointer-events: none;\r\n    }\r\n\r\n    .menuList .disabledanchor {\r\n        cursor: not-allowed;\r\n        pointer-events: none;\r\n    }\r\n\r\n    .menuList .disabledisplay {\r\n        display: none;\r\n    }\r\n</style>\r\n<nav class=\"navbar navbar-default\" data-ng-if=\"(!udata || udata.appStatus != 'C') && (!hidemenu)\">\r\n    <div class=\"container\">\r\n        <div id=\"main\" class=\"navbar-collapse collapse\">\r\n            <ul class=\"nav navbar-nav\" link=\"\">\r\n                <li class=\"menuList\"\r\n                    data-ng-class=\"{'active': ['dashboard','home'].indexOf(servers.NAV_COMPONENT) > -1, 'disabled' :udata.disableMenu}\"\r\n                    data-toggle=\"tooltip\" data-placement=\"top\">\r\n                    <a data-ng-show=\"udata && udata.role == 'login'\"\r\n                        data-ng-href=\"{{servers.GST_SERVICES_R1_URL}}/services/auth/dashboard\">Dashboard</a>\r\n                    <a data-ng-show=\"udata && udata.role == 'panLogin'\"\r\n                        data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/dashboard\">Dashboard</a>\r\n                    <a class=\"nav_home\" data-ng-show=\"!udata || udata.role == undefined\" data-ng-class=\"{'disabled' : pwdExpired === 'Y'}\" ng-click=\"handleHomeClick($event)\"\r\n                        data-ng-href=\"{{servers.GST_CONTENT_R1_URL}}/\">Home</a>\r\n                </li>\r\n                <!-- CR#22679 Enabling changes -->\r\n                <li class=\"dropdown drpdwn menuList\"\r\n                    data-ng-class=\"{'active': servers.NAV_COMPONENT == 'services', 'disabled' :udata.disableMenu && !enableServices}\">\r\n                    <a data-ng-href=\"#\"\r\n                        data-ng-class=\"{'disabledanchor' : udata.disableMenu && !enableServices, 'dropdown-toggle' : !udata.disableMenu && !enableServices}\"\r\n                        data-toggle=\"dropdown\" role=\"button\" aria-expanded=\"false\">Services <span\r\n                            class=\"caret\"></span></a>\r\n                    <ul class=\"dropdown-menu smenu\" role=\"menu\">\r\n                        <li class=\"has-sub\" data-ng-hide=\"(udata.utype=='RF'  || udata.utype=='ES')\"\r\n                            data-ng-class=\"{'disabled' :udata.disableMenu && !enableServices}\">\r\n                            <a data-ng-show=\"!udata || (udata && udata.role == 'panLogin')\"\r\n                                data-ng-href=\"{{servers.GST_SERVICES_R1_URL}}/services/quicklinks/registration\"\r\n                                data-ng-class=\"{'disabledanchor' :udata.disableMenu, 'dropdown-toggle' : !udata.disableMenu}\">Registration</a>\r\n                            <div data-ng-if=\"enableServices\">\r\n                                <a data-ng-show=\"udata && udata.role == 'login'\"\r\n                                    data-ng-class=\"{'disabledanchor' : udata.disableMenu && !enableServices, 'dropdown-toggle' : !udata.disableMenu && !enableServices}\"\r\n                                    style='display: block;text-decoration: none;'>Registration</a>\r\n                            </div>\r\n                            <div data-ng-if=\"!enableServices\">\r\n                                <a data-ng-show=\"udata && udata.role == 'login'\" target=\"_self\"\r\n                                    data-ng-href=\"{{servers.GST_SERVICES_R1_URL}}/services/auth/quicklinks/registration\"\r\n                                    data-ng-class=\"{'disabledanchor' : udata.disableMenu && !enableServices, 'dropdown-toggle' : !udata.disableMenu && !enableServices}\"\r\n                                    style='display: block;text-decoration: none;'>Registration</a>\r\n                            </div>\r\n\r\n                            <ul class=\"isubmenu serv\">\r\n                                <li data-ng-hide=\"udata.utype=='TR' || udata.utype=='UN'  || udata.utype == 'O' || udata.utype == 'TPCAEX' || udata.utype == 'NREX' || udata.utype == 'AR'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu}\" data-toggle=\"tooltip\"\r\n                                    data-placement=\"top\">\r\n                                    <a data-ng-href=\"{{(udata)? servers.GST_REGISTRATION_R1_URL + '/registration' : servers.GST_REGISTRATION_R1_URL+'/registration'}}\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">New Registration</a>\r\n                                </li>\r\n                                <li data-ng-hide=\"udata.utype=='TR' || udata.utype == 'AR'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu}\" data-toggle=\"tooltip\"\r\n                                    data-placement=\"top\">\r\n                                    <a data-ng-show=\"udata\"\r\n                                        data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/clarifications\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">Application for Filing\r\n                                        Clarifications</a>\r\n                                    <a data-ng-show=\"!udata\"\r\n                                        data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">Application for Filing\r\n                                        Clarifications</a>\r\n                                </li>\r\n                                <li data-ng-show=\"udata && (udata.role == 'login') && udata.IS_MIGRATED == 'Y' && udata.appStatus == 'A' && udata.utype!='TR' && udata.utype != 'TD' && udata.utype != 'TS' && udata.utype != 'NR' && udata.utype != 'NREX' && udata.utype!='O' && udata.utype!='UN' && udata.utype != 'AR'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu && !enableServices}\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/amend/core/amendbusinessdetail\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu && !enableServices}\">Amendment\r\n                                        of Registration Core Fields</a>\r\n                                </li>\r\n                                <!-----cr 24843-->\r\n                                <li\r\n                                    data-ng-show=\"udata && (udata.role == 'login')&& (udata.utype=='TP' || udata.regType=='NT' || udata.regType=='ID' || udata.regType=='CA' || udata.regType=='CO') && (udata.isGeocoding == 'Y')\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/geocode\">\r\n                                        Geocoding Business Addresses</a>\r\n                                </li>\r\n                                <!-----cr 24843 ends-------->\r\n                                <li data-ng-show=\"udata && (udata.role == 'login') && udata.IS_MIGRATED == 'N' && udata.utype!='TR' && udata.utype != 'TD' && udata.utype != 'TS' && udata.utype != 'NR' && udata.utype != 'NREX' && udata.utype!='O' && udata.utype!='TPCAEX' && udata.utype!='UN' && udata.utype != 'AR'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu && !enableServices}\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/amend/core/amendbusinessdetail\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu && !enableServices}\">Amendment\r\n                                        of Registration Core Fields</a>\r\n                                </li>\r\n                                <li data-ng-show=\"udata && udata.role == 'login' && udata.utype=='UN'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu && !enableServices}\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/amend/uin/core/businessdetails\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu && !enableServices}\">Amendment\r\n                                        of Registration Core Fields</a>\r\n                                </li>\r\n                                <li data-ng-show=\"udata && (udata.role == 'login') && udata.IS_MIGRATED == 'Y' && udata.appStatus == 'A' && udata.utype!='TR' && udata.utype != 'TD' && udata.utype != 'TS' && udata.utype != 'NR' && udata.utype != 'NREX' && udata.utype!='UN' && udata.utype!='O' && udata.utype != 'AR'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu && !enableServices}\"\r\n                                    data-placement=\"top\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/amend/noncore/business\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu && !enableServices}\">Amendment\r\n                                        of Registration Non - Core Fields</a>\r\n                                </li>\r\n                                <li data-ng-show=\"udata && (udata.role == 'login') && udata.IS_MIGRATED == 'N' && udata.utype!='TR' && udata.utype != 'TD' && udata.utype != 'TS' && udata.utype != 'NR' && udata.utype != 'NREX' && udata.utype!='UN' && udata.utype!='O' && udata.utype != 'AR'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu && !enableServices}\"\r\n                                    data-placement=\"top\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/amend/noncore/business\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu && !enableServices}\">Amendment\r\n                                        of Registration Non - Core Fields</a>\r\n                                </li>\r\n                                <li data-ng-show=\"udata && udata.role == 'login' && udata.utype=='UN'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu}\" data-toggle=\"tooltip\"\r\n                                    data-placement=\"top\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/amend/uin/noncore/authsign\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">Amendment of Registration\r\n                                        Non - Core Fields</a>\r\n                                </li>\r\n                                <li data-ng-show=\"udata && udata.role == 'login' && (udata.utype=='NR' || udata.utype=='NREX'|| udata.utype=='TD' || udata.utype=='TS' || udata.utype=='O')\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu}\" data-toggle=\"tooltip\"\r\n                                    data-placement=\"top\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/comnamend/noncore/basicdtls\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">Amendment of Registration\r\n                                        Non - Core Fields</a>\r\n                                </li>\r\n                                <li data-ng-show=\"udata && udata.role == 'login' && udata.utype=='TR'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu}\" data-toggle=\"tooltip\"\r\n                                    data-placement=\"top\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/comnamend/noncore/bank\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">Amendment of Registration\r\n                                        Non - Core Fields</a>\r\n                                </li>\r\n                                <li data-ng-show=\"udata && udata.role == 'login' && (udata.utype=='TD' || udata.utype=='TS' || udata.utype=='NR' || udata.utype=='O')\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu && !enableServices}\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/comnamend/core/basicdetails\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu && !enableServices}\">Amendment\r\n                                        of Registration Core Fields</a>\r\n                                </li>\r\n                                <li data-ng-show=\"udata && udata.role == 'login' && udata.utype!='TR' && udata.utype!='O' && udata.utype!='UN'  && udata.utype != 'TPCAEX' && udata.utype != 'NREX' && udata.utype != 'AR' && udata.utype != 'RF'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu}\" data-toggle=\"tooltip\"\r\n                                    data-placement=\"top\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/optcomp\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">Application to Opt for\r\n                                        composition Levy</a>\r\n                                </li>\r\n                                <li data-ng-show=\"udata && udata.role == 'login' && udata.utype!='TR'  && udata.utype!='O' && udata.utype!='UN' && udata.utype != 'TPCAEX' && udata.utype != 'NREX' && udata.utype != 'AR' && udata.utype != 'RF'\"\r\n                                    data-ng-class=\"{'disabled' :udata.disableMenu}\" data-toggle=\"tooltip\"\r\n                                    data-placement=\"top\">\r\n                                    <a data-ng-href=\"{{servers.GST_REGISTRATION_R1_URL}}/registration/auth/wtdrwcomp\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disableMenu}\">Application for Withdrawal\r\n                                        from Composition Levy</a>\r\n                                </li>\r\n                                <li data-ng-class=\"{'disabled' :udata.disableMenu}\" data-toggle=\"tooltip\"\r\n                                    data-placement=\"top\" data-ng-hide=\"udata.utype == 'ES'\">\r\n                                    <a data-ng-show=\"udata && udata.role == 'panLogin'\"\r\n                                        data-ng-href=\"{{servers.GST_SERVICES_R1_URL}}/services/auth/appstatus\"\r\n                                        data-ng-class=\"{'disabledanchor' :udata.disab...[truncated at 15000 chars]"
